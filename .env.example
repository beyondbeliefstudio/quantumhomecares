# Copy this file to .env and fill in real values. Never commit .env to git.

PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_AHREFS_DATA_KEY=
PUBLIC_USERBACK_TOKEN=

# --- AxisCare lead integration (Netlify functions) ---
# Set these in the Netlify UI under Site configuration -> Environment variables.

AXISCARE_SITE_NUMBER=15969
AXISCARE_API_TOKEN=

# AxisCare has no sandbox, so a live call writes a real lead to the production
# account. Leave this on until the flow has been walked end to end; the approve
# page then reports a dry run and leaves the token unused for the real click.
AXISCARE_DRY_RUN=true

# Deferred — leads are not tagged with a referral source for now. Only sent when
# one of these is set, because a source name that does not already exist in the
# account can get an otherwise-valid lead rejected. Read the configured names
# from GET /api/referral/other before filling these in.
AXISCARE_REFERRAL_SOURCE_NAME=
AXISCARE_REFERRAL_SOURCE_ID=
AXISCARE_REFERRAL_SOURCE_TYPE=other

OWNER_EMAIL=
FROM_EMAIL=
RESEND_API_KEY=
SITE_URL=
