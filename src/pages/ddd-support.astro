---
// LAYOUT
import Layout from "@/layouts/Layout.astro";

// COMPONENTS
import Heading from "@/components/Heading.astro";
import InternalHero from "@/components/InternalHero.astro";
import Links from "@/components/Links.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// DATA
import { dddServices, programNote, commitments, startSteps } from "@/data/dddData";
import { baseData, schemaIds } from "@/data/siteData";

// IMAGES
import heroPhoto from "@/assets/photos/newStock/pexels-cliff-booth-4058413.jpg";

/**
 * A SHORT PAGE, ON PURPOSE.
 *
 * This ran long — a photo chapter card per service with a paragraph and a
 * bulleted "what this includes" on each, a two-branch getting-started section,
 * and an eleven-item subnav rail over the top. Chris cut it back: DDD is a new
 * line beside senior care, and this page's job is to say we do it, list what we
 * are approved for, and hand the reader a phone number.
 *
 * So the shape is five sections and no rail. Every service is one line in one
 * grid. Before adding a section here, check whether it could be a sentence.
 *
 * VOICE: the hero used to open "Most of our work is senior care, and that is
 * not changing." True internally, and wrong on the page — to a family weighing
 * us up for a DDD plan it reads as a hedge, as though this were something we
 * dabble in (Chris, 2026-09-16). Nothing visitor-facing should frame DDD as the
 * smaller line of business, or compare it to the senior work at all. That DDD
 * is deliberately one restrained page is a site-architecture decision; it is
 * not a thing to say out loud to the people reading it.
 *
 * PHOTOGRAPHY: every service card carries a photo rather than an icon, which
 * the library does not really have the stock for — three of the seven are
 * placeholders borrowed from other pages. The full accounting, and what to buy
 * to replace them, is in the photography note at the top of dddData.ts. The
 * who-qualifies block gave up its photo to feed the grid; it reads fine as a
 * centred block and the page got shorter for it.
 */

/**
 * One Service node per DDD service, pointing at the LocalBusiness node BaseHead
 * emits. Generated from the array the page renders, so a service cannot ship
 * without its structured data.
 */
const { business: businessId } = schemaIds(Astro.site);

const serviceSchema = dddServices.map(service => ({
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.lead,
  provider: { "@id": businessId },
  areaServed: { "@type": "State", name: baseData.serviceArea.state },
  audience: {
    "@type": "Audience",
    audienceType: "Adults with intellectual and developmental disabilities",
  },
}));
---

<Layout
  pageTitle="DDD Support Services in New Jersey | Quantum Home Cares"
  description="In-home and community support for adults with intellectual and developmental disabilities, anywhere in New Jersey. An approved provider with the NJ Division of Developmental Disabilities."
  schemaNodes={serviceSchema}
  contactTitle="Want to talk it through?"
  contactLead="Tell us about the person you're asking for and what a good week would look like for them. We'll give you a straight answer about whether we're the right people for it."
>
  <!-- ===== 1. INTRO ===== -->
  <InternalHero
    eyebrow="DDD Support"
    title="Support for adults with developmental disabilities."
    image={heroPhoto}
    imageAlt="A boxing coach and a young woman with Down syndrome talking together at a community gym"
  >
    <p class="lead">
      Quantum Home Cares supports adults with intellectual and developmental disabilities across New
      Jersey, at home and out in the community. We're an approved provider with the state Division
      of Developmental Disabilities.
    </p>
    <p class="lead">
      What that looks like varies a lot from one person to the next. Some people want a couple of
      hours in the morning and to be left to it after that. Others want somebody along at work, or
      at the gym, or on a bus route they're still learning. We'd sooner work out which you are on
      the first visit than hand you a standard schedule.
    </p>
  </InternalHero>

  <!-- ===== 2. WHAT WE'RE APPROVED FOR ===== -->
  <section id="services" class="section" data-reveal>
    <div class="stack ddd__intro">
      <span class="eyebrow">What We Provide</span>
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        What we can help with.
      </Heading>
      <p class="lead">
        Most people start with one or two of these and change things around as life does. If you're
        not sure which ones fit, that's a normal place to be starting from.
      </p>
    </div>

    <!-- Seven services plus the call-us card fill a four-wide grid exactly, and
         the eighth card is why the grid has no hole in it. Adding an approved
         service means dropping to seven again — let the CTA wrap to a third
         row rather than cutting a service to keep the rectangle. -->
    <ul class="svc-grid auto-grid auto-grid--four" data-stagger>
      {
        dddServices.map(service => (
          <li class="svc-grid__card">
            <div class="svc-grid__media">
              <Image
                src={service.photo}
                alt={service.photoAlt}
                width={720}
                widths={[360, 540, 720]}
                sizes="(max-width: 682px) 92vw, (max-width: 1298px) 46vw, 23vw"
              />
            </div>
            <div class="svc-grid__copy">
              <Heading tag="h3" size="xs" fontFamily="primary" weight="fw400" marginBottom="none">
                {service.title}
              </Heading>
              <p class="svc-grid__lead">{service.lead}</p>
            </div>
          </li>
        ))
      }

      <!-- Eighth slot. Not a service, so it gets no photo and no h3 — it is the
           catch for everything the approval letter does not cover. -->
      <li class="svc-grid__card svc-grid__card--ask">
        <p class="svc-grid__asklead">Don't see what you need?</p>
        <p class="svc-grid__askbody">
          Give us a call anyway and tell us what you're after. If it isn't something we do, we can
          usually point you to somebody who does.
        </p>
        <a class="svc-grid__asklink" href={`tel:${baseData.phone.replace(/\D/g, "")}`}>
          Call {baseData.phone}
          <Icon name="arrow-right" aria-hidden="true" />
        </a>
      </li>
    </ul>

    <p class="ddd__note">
      Behavioral Supports, Occupational Therapy and Physical Therapy are provided by licensed
      practitioners we bring in. They aren't something your regular caregiver does.
    </p>
  </section>

  <!-- ===== 3. WHAT TO EXPECT =====
       Three promises, so they are set as three promises: heading anchored left,
       the commitments as ruled rows across the wide half. This was a 44rem
       centred column with a checklist in it and the band swallowed it — the
       copy is the section, so it gets the width. -->
  <section id="who" class="band band--up" data-reveal>
    <div class="band__inner">
      <div class="split split--4-7 split--top">
        <div class="stack who__lede">
          <span class="eyebrow eyebrow--band">How We Work</span>
          <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
            What you can expect from us.
          </Heading>
        </div>

        <div class="who__body">
          <dl class="who__list">
            {
              commitments.map(item => (
                <div class="who__item" data-stagger>
                  <span class="who__mark" aria-hidden="true">
                    <Icon name="check" />
                  </span>
                  <dt class="who__label">{item.label}</dt>
                  <dd class="who__copy">{item.copy}</dd>
                </div>
              ))
            }
          </dl>

          <p class="who__aside">
            If any of that sounds like what you've been looking for, the next step is a conversation
            rather than a form.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4 + 5. STARTING, AND THE COORDINATOR CLOSE =====
       One band. Both halves are about the same route in: the coordinator holds
       the plan and the budget, so they are the one who adds a provider. -->
  <section id="getting-started" class="section" data-reveal>
    <div class="coord">
      <div class="split split--top split--gap-sm">
        <div class="stack coord__intro">
          <span class="eyebrow eyebrow--band">Getting Started</span>
          <Heading tag="h2" size="l" fontFamily="primary" weight="fw400" marginBottom="none">
            Asking for us is straightforward.
          </Heading>
          <p class="lead">
            If you already have a Support Coordinator, telling them you'd like to work with us is
            all it takes. You don't need to arrange anything with us first. If you'd rather talk to
            us before any of that, call and we'll walk you through it.
          </p>

          <ol class="coord__steps">
            {startSteps.map(step => <li>{step}</li>)}
          </ol>
        </div>

        <div class="stack coord__side">
          <span class="eyebrow eyebrow--band">For Support Coordinators</span>
          <p>
            We take cases anywhere in New Jersey and come back to you on referrals the same business
            day. Marvalyn handles them herself, so you won't be leaving messages with an intake
            line. We support adults 21 and older who have been found eligible by the Division.
          </p>
          <p class="coord__note">{programNote}</p>

          <div class="coord__cta">
            <Links variant="primary" href="/for-professionals/#referral">
              Send a referral
              <Icon name="arrow-right" aria-hidden="true" />
            </Links>
            <Links variant="outline" href={`tel:${baseData.phone.replace(/\D/g, "")}`}>
              Call {baseData.phone}
            </Links>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  /* ----- Shared section intro ----- */
  .ddd__intro {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;

    /* .stack is a flex column and .eyebrow is width: fit-content, so the pill
       pins to the left edge on its own — text-align only centres the letters
       inside it. */
    .eyebrow {
      align-self: center;
    }
  }

  /* The one qualifying line the specialist services need. Small and centred so
     it reads as a footnote to the grid rather than a fourth row of it. */
  .ddd__note {
    max-width: 44rem;
    margin: 2rem auto 0;
    font-size: var(--qhc-size-body-s);
    color: var(--qhc-slate-600);
    text-align: center;
  }

  /* ----- The whole service list: one line each ----- */
  .svc-grid {
    --min: 15rem;
    --gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;

    &__card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--qhc-white);
      border: 1px solid var(--qhc-hairline-strong);
      border-radius: var(--qhc-radius-lg);
    }

    /* Fixed ratio so every photo in the row crops to the same band — the source
       images are a mix of portrait and landscape and would otherwise set eight
       different card heights. */
    &__media {
      position: relative;
      aspect-ratio: 4 / 3;
      background: var(--qhc-navy-050);

      img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__copy {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: clamp(1.125rem, 2.5vw, 1.375rem);

      /* Two of the seven titles run to two lines, which dropped their lead copy
         out of line with the rest of the row. Reserve both lines on every card
         so the paragraphs start at the same height. 2.5em = two lines at the
         .fs-xs line-height of 1.25. */
      :global(h3) {
        min-height: 2.5em;
      }

      /* One card per row, so there is nothing left to align to and the
         reserved second line is just a gap. Matches auto-grid--four's own
         single-column breakpoint. */
      @media (max-width: 682px) {
        :global(h3) {
          min-height: 0;
        }
      }
    }

    &__lead {
      margin: 0;
      font-size: var(--qhc-size-body-s);
      color: var(--qhc-slate-600);
    }

    /* The catch-all card. No photo, so it fills the same footprint with the
       tint instead — it should read as the end of the list, not a service that
       lost its picture. */
    &__card--ask {
      gap: 0.625rem;
      justify-content: center;
      padding: clamp(1.375rem, 3vw, 1.75rem);
      background: var(--qhc-navy-050);
      border-color: var(--qhc-navy-300);
    }

    &__asklead {
      margin: 0;
      font-size: var(--qhc-size-body-m);
      color: var(--qhc-ink-900);
    }

    &__askbody {
      margin: 0;
      font-size: var(--qhc-size-body-s);
      color: var(--qhc-slate-600);
    }

    &__asklink {
      display: inline-flex;
      gap: 0.375rem;
      align-items: center;
      margin-top: 0.25rem;
      font-weight: 600;
      color: var(--qhc-navy-700);
      text-decoration: none;

      [data-icon] {
        width: 1rem;
        height: 1rem;
        transition: transform 0.2s ease;
      }

      &:hover [data-icon] {
        transform: translateX(3px);
      }
    }
  }

  /* ----- What to expect ----- */
  .who {
    /* .stack is a flex column and .eyebrow is width: fit-content, so the pill
       needs no help here — left-aligned, it already sits on the edge. */
    &__lede {
      --gap: 1.25rem;
    }

    &__list {
      margin: 0;
      /* Hairlines, not cards. The section above this one is a grid of white
         cards; repeating them here flattened the two sections into one. */
      border-bottom: 1px solid var(--qhc-hairline-cool);
    }

    &__item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1.25rem;
      padding: 1.75rem 0;
      border-top: 1px solid var(--qhc-hairline-cool);

      /* The rules are separators, so the set opens on the first label rather
         than on a line — which also pulls it level with the eyebrow opposite. */
      &:first-child {
        padding-top: 0;
        border-top: 0;
      }
    }

    /* White chip with a cool edge — the tinted-band rule the how-it-works
       markers follow, so marks read the same way across the site. */
    &__mark {
      display: grid;
      place-items: center;
      grid-row: span 2;
      align-self: start;
      width: 2.5rem;
      height: 2.5rem;
      margin-top: 0.125rem;
      background: var(--qhc-white);
      border: 1px solid var(--qhc-navy-300);
      border-radius: var(--qhc-radius-circle);
      color: var(--qhc-navy-700);

      [data-icon] {
        width: 1.0625rem;
        height: 1.0625rem;
      }
    }

    &__label {
      font-family: var(--qhc-font-display);
      font-size: var(--qhc-size-statement);
      font-weight: 400;
      line-height: 1.2;
      color: var(--qhc-navy-900);
    }

    &__copy {
      max-width: 54ch;
      margin: 0.5rem 0 0;
      font-size: var(--qhc-size-body-s);
      color: var(--qhc-slate-600);
    }

    &__aside {
      max-width: 54ch;
      margin: 1.75rem 0 0;
      font-size: var(--qhc-size-body-s);
      color: var(--qhc-slate-600);
    }

    /* Stacked, the mark column costs more than it earns — the labels line up
       with the heading above them instead. */
    @media (max-width: 616px) {
      &__item {
        grid-template-columns: minmax(0, 1fr);
        row-gap: 0.75rem;
        padding: 1.375rem 0;
      }

      &__mark {
        grid-row: auto;
        width: 2.125rem;
        height: 2.125rem;
        margin-top: 0;
      }
    }
  }

  /* ----- Getting started + coordinator close, one panel ----- */
  .coord {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--qhc-navy-050);
    border: 1px solid var(--qhc-navy-300);
    border-radius: var(--qhc-radius-lg);

    &__intro,
    &__side {
      --gap: 1rem;
    }

    &__steps {
      display: grid;
      gap: 0.625rem;
      margin: 0.25rem 0 0;
      padding-left: 1.125rem;

      li {
        padding-left: 0.25rem;
        font-size: var(--qhc-size-body-s);
      }

      &::marker {
        color: var(--qhc-navy-700);
      }
    }

    /* The program split. Factual, coordinator-facing, and deliberately quieter
       than the copy above it — a family does not need to parse this. */
    &__note {
      margin: 0;
      padding-top: 1rem;
      font-size: var(--qhc-size-body-s);
      color: var(--qhc-slate-600);
      border-top: 1px solid var(--qhc-navy-300);
    }

    &__cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }
  }
</style>
