---
// Temporary test harness for the AxisCare lead integration. Deliberately
// standalone — it does not use Layout, Nav, Footer, or any site component, so
// deleting this one file removes the page completely.
//
// Not linked from anywhere, noindex'd below, and excluded from the sitemap in
// astro.config.mjs (remove that filter entry when this page goes).

const submitted = Astro.url.searchParams.has("submitted");

const helpTypes = [
  "Daily living support",
  "Meals and nutrition",
  "Transportation and companionship",
  "Respite care",
  "Overnight or live-in",
  "Not sure yet",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Test Form</title>
    <style>
      body {
        margin: 0;
        padding: 2rem 1.25rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        line-height: 1.5;
        color: #111;
      }
      main {
        max-width: 34rem;
        margin: 0 auto;
      }
      label {
        display: block;
        margin: 0.85rem 0 0.25rem;
        font-weight: 600;
      }
      input,
      select,
      textarea {
        width: 100%;
        padding: 0.5rem;
        font: inherit;
        border: 1px solid #999;
        border-radius: 3px;
        box-sizing: border-box;
      }
      button {
        margin-top: 1.25rem;
        padding: 0.6rem 1.4rem;
        font: inherit;
        cursor: pointer;
      }
      .note {
        margin-top: 1rem;
        font-size: 0.9rem;
        color: #555;
      }
      .banner {
        padding: 0.75rem 1rem;
        border: 1px solid #1a7f5a;
        border-radius: 3px;
        background: #eef7f2;
      }
      .hidden {
        position: absolute;
        left: -9999px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Test Form</h1>
      <p class="note">
        Test harness for the AxisCare lead integration. Not linked from the site and not indexed.
      </p>

      {
        submitted && (
          <p class="banner">
            Submitted. If it passed validation, an approval email is on its way to the owner
            address.
          </p>
        )
      }

      <form
        name="test-form"
        method="POST"
        action="/test-form?submitted=1"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="test-form" />
        <input type="hidden" name="source" value="test-form" />

        <p class="hidden">
          <label
            >Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label
          >
        </p>

        <label for="firstName">First name *</label>
        <input id="firstName" name="firstName" type="text" autocomplete="given-name" required />

        <label for="lastName">Last name *</label>
        <input id="lastName" name="lastName" type="text" autocomplete="family-name" required />

        <label for="phone">Phone *</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" required />

        <label for="email">Email *</label>
        <input id="email" name="email" type="email" autocomplete="email" required />

        <label for="helpType">What kind of help are you looking for? *</label>
        <select id="helpType" name="helpType" required>
          <option value="">Choose one</option>
          {helpTypes.map(option => <option value={option}>{option}</option>)}
        </select>

        <label for="notes">Anything else you want us to know</label>
        <textarea id="notes" name="notes" rows="4"></textarea>

        <button type="submit">Submit</button>

        <p class="note">
          Please leave out medical details. We will gather what we need when we speak.
        </p>
      </form>
    </main>
  </body>
</html>
