---
// LAYOUT
import Layout from "@/layouts/Layout.astro";

// SECTIONS — rendered top to bottom in this order.
// Condensed per design_handoff_quantum_homepage/buildout-notes/01-home.md.
// What left this page and where it went:
//   WhoWeHelp, Culture, Coverage, InTheNews  → /our-approach
//   PhotoStrip                               → distributed across interior pages
// Those components still exist and still have their data in homeData.ts.
import AlertPopup from "@/components/AlertPopup.astro";
import Hero from "@/components/Hero.astro";
import CredentialBand from "@/components/CredentialBand.astro";
import WhyFamilies from "@/components/WhyFamilies.astro";
import Services from "@/components/Services.astro";
import DddCallout from "@/components/DddCallout.astro";
import Approach from "@/components/Approach.astro";
import QuoteBanner from "@/components/QuoteBanner.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import ForProfessionals from "@/components/ForProfessionals.astro";
import Resources from "@/components/Resources.astro";
import FAQ from "@/components/FAQ.astro";
import Testimonial from "@/components/Testimonial.astro";
// The contact band is rendered by Layout on every page — not imported here.

// DATA
import { faqs } from "@/data/homeData";

// Built from the same array the FAQ section renders, so the markup and the
// structured data cannot drift apart — edit the questions in homeData.ts only.
const faqSchema = {
  "@type": "FAQPage",
  mainEntity: faqs.map(faq => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  pageTitle="Quantum Home Cares | In-Home Senior Care Across New Jersey"
  description="Advocacy-led in-home senior care across New Jersey: daily living support, meals, transportation, respite, and an advocate in the room at medical appointments."
  schemaNodes={[faqSchema]}
>
  <!-- Announcement modal. One at a time, and when this one is over comment the
       tag out rather than deleting it — the next announcement is an edit of
       these props. See the usage note in AlertPopup.astro. -->
  <AlertPopup
    eyebrow="In the News"
    title="Marvalyn is on the Voice To Success podcast."
    body={[
      "Our founder joined the Voice To Success podcast for a 32-minute conversation about Quantum Home Cares and the standard she holds it to.",
    ]}
    ctaLabel="Listen to the episode"
    ctaHref="https://open.spotify.com/episode/2g2Mm8WfWarIRy4xSVCYFX"
    ctaExternal
  />

  <Hero />
  <CredentialBand />
  <WhyFamilies />
  <Services />
  <Approach />
  <QuoteBanner />
  <HowItWorks />
  <!-- Two framed panels of the same grammar, inverted against each other and
       spaced as a pair — the two audiences that route off this page. -->
  <ForProfessionals />
  <DddCallout />
  <Resources />
  <FAQ />
  <!-- Last before the contact band Layout appends — the proof sits directly
       against the ask. -->
  <Testimonial />
</Layout>
