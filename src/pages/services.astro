---
// LAYOUT
import Layout from "@/layouts/Layout.astro";

// COMPONENTS
import Heading from "@/components/Heading.astro";
import InternalHero from "@/components/InternalHero.astro";
import ServicesSubnav from "@/components/ServicesSubnav.astro";
import ServiceBlock from "@/components/ServiceBlock.astro";
import PhotoStrip from "@/components/PhotoStrip.astro";

// DATA
import { serviceDetails } from "@/data/servicesData";
import { baseData, schemaIds } from "@/data/siteData";

// IMAGES
import heroPhoto from "@/assets/photos/newStock/dominik-lange-VUOiQW4OeLI-unsplash.jpg";

/**
 * One Service node per block, each pointing at the single LocalBusiness node
 * BaseHead emits rather than restating the business. Generated from the same
 * array the page renders, so a new service cannot ship without its schema.
 */
const { business: businessId } = schemaIds(Astro.site);

const serviceSchema = serviceDetails.map(service => ({
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.lead,
  provider: { "@id": businessId },
  areaServed: { "@type": "State", name: baseData.serviceArea.state },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${service.title} — what this includes`,
    itemListElement: service.includes.map(item => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: item },
    })),
  },
}));
---

<Layout
  pageTitle="Senior Home Care Services in New Jersey | Quantum Home Cares"
  description="In-home care across New Jersey: personal care, meals, transportation, respite, overnight and live-in support, plus advocacy at medical appointments."
  schemaNodes={serviceSchema}
  contactTitle="Not sure what your family needs?"
  contactLead="That is the most common place people start. Tell us what is going on and we will help you sort out what would actually help, even if that turns out to be less care than you expected. The conversation is free and there is nothing to sign."
>
  <!-- ===== 1. PAGE INTRO ===== -->
  <InternalHero
    eyebrow="What We Do"
    title="Care that fits the person, not a package."
    image={heroPhoto}
    imageAlt="A caregiver walking a senior woman in a wheelchair across a sunlit field at golden hour"
  >
    <p class="lead">
      Most agencies hand you a tier. Bronze, silver, gold, pick one. It is easier to sell that way,
      but it has almost nothing to do with what any particular person actually needs.
    </p>
    <p class="lead">
      We start the other direction. We visit the home, we talk to your loved one and to you, and we
      build a written plan around the real situation. Someone recovering from a hip replacement
      needs something completely different from someone in the early stages of dementia, and both of
      those change over time.
    </p>
    <p class="lead">
      Below is everything we provide. Most families start with two or three of these and add more as
      things shift. Nothing here is locked in.
    </p>
  </InternalHero>

  <ServicesSubnav />

  <!-- ===== 2–7. THE SIX SERVICES ===== -->
  {serviceDetails.map((service, i) => <ServiceBlock service={service} flip={i % 2 === 1} />)}

  <!-- Chapter break between what we do and how it is scheduled -->
  <PhotoStrip />

  <!-- ===== 8. SCHEDULING ===== -->
  <section id="scheduling" class="section" data-reveal>
    <div class="split split--4-7 split--top">
      <div class="stack scheduling__intro">
        <Heading tag="h2" size="l" fontFamily="primary" weight="fw400" marginBottom="none">
          How hours and scheduling work
        </Heading>
      </div>

      <div class="stack scheduling__body">
        <p class="lead">
          Every plan is built around the actual week. Some families need four hours on a Tuesday and
          Thursday. Others need daily mornings, or full days, or somebody in the house around the
          clock.
        </p>
        <p class="lead">
          Once we know the schedule, we match a caregiver and keep them consistent. That consistency
          matters more than most families expect. A person who has to explain their routine to a
          different face every week never really settles, and someone with memory changes may never
          settle at all.
        </p>
        <p class="lead">
          Every client also gets a named backup caregiver who already knows the care plan, so
          vacations and sick days do not turn into a stranger at the door.
        </p>
        <p class="lead">
          Schedules change, and that is normal. Recovery goes well and hours come down. A diagnosis
          changes and hours go up. We adjust the plan and the schedule with it. There is no long
          contract holding you to a level of care you no longer need.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 9. "What we do not do" was cut in design review (2026-08-05) —
       the skilled-nursing question in 02-services.md's accuracy note was
       still open, and the page reads fine without it. Restore from git
       history if the client wants the honest-scope section back. -->

  <!-- ===== 10. PAGE CTA ===== is the sitewide contact band, retitled via the
       contactTitle / contactLead props on Layout above. The 02-services.md CTA
       copy lives there, and the reader gets the form itself instead of a
       button that would only have carried them to it. -->
</Layout>

<style lang="scss">
  .scheduling {
    &__body {
      --gap: 1.25rem;
    }
  }
</style>
