---
// LAYOUT
import Layout from "@/layouts/Layout.astro";

// COMPONENTS
import Heading from "@/components/Heading.astro";
import InternalHero from "@/components/InternalHero.astro";
import ApproachComparison from "@/components/ApproachComparison.astro";
import WhoWeHelp from "@/components/WhoWeHelp.astro";
import Culture from "@/components/Culture.astro";
import About from "@/components/About.astro";
import InTheNews from "@/components/InTheNews.astro";
import Careers from "@/components/Careers.astro";
import CareerForm from "@/components/CareerForm.astro";

// HELPERS

// DATA
import { credentials } from "@/data/approachData";
import { baseData, schemaIds, telHref, mailHref } from "@/data/siteData";

// IMAGES
import heroPhoto from "@/assets/photos/quote-path.jpg";

// SCHEMA — AboutPage hanging off the graph BaseHead already emits: the page
// is about the business, and its main entity is the founder.
const { business: businessId, founder: founderId } = schemaIds(Astro.site);

const aboutSchema = {
  "@type": "AboutPage",
  name: "Our Approach and Founder's Story",
  url: Astro.url.toString(),
  about: { "@id": businessId },
  mainEntity: { "@id": founderId },
};
---

<!--
  Page order is deliberate (design review 2026-08-05): the business case
  leads — difference, who we help, how plans work, the six Cs — and Marvalyn
  arrives afterwards, as the person behind the standard rather than the
  subject of the page. Her section is the original homepage About block,
  restored verbatim (client-provided copy).
-->
<Layout
  pageTitle="Our Approach and Founder's Story | Quantum Home Cares New Jersey"
  description="Marvalyn Ellis founded Quantum Home Cares after 25 years managing her own parents' care. Advocacy-led senior home care built around one family at a time."
  schemaNodes={[aboutSchema]}
  hideCTA
>
  <!-- ===== 1. PAGE INTRO — the pitch is the hero ===== -->
  <InternalHero
    eyebrow="Our Approach"
    title="Most agencies send help. We show up and follow through."
    image={heroPhoto}
    imageAlt="An older couple sitting together looking out over a vineyard"
  >
    <p class="lead">
      Large home care agencies run on clinical quotas and insurance billing. An aide is assigned,
      hours are logged, the visit closes, and the family is still the one on hold with the insurance
      company at four in the afternoon.
    </p>
    <p class="lead">
      We work the other way. We build the care plan and we maintain it. We go to the appointments.
      We follow up on referrals and test results. We handle the calls and the forms. And we stay in
      touch before something goes wrong, not after.
    </p>
    <p class="lead hero-strong">
      Advocacy is not an add-on service here. It is the reason this company exists.
    </p>
  </InternalHero>

  <!-- ===== 2. THE DIFFERENCE, LINE BY LINE ===== -->
  <section id="comparison" class="section" data-reveal>
    <div class="section-header comparison__header">
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        Here is the difference, line by line.
      </Heading>
    </div>

    <ApproachComparison />
  </section>

  <!-- ===== 3. WHO WE HELP ===== -->
  <WhoWeHelp />

  <!-- ===== 4. HOW CARE PLANS GET BUILT — temporarily pulled (client call
       2026-08-11). Markup and .plan styles live in git history; the
       carePlanIntro / carePlanSteps data remains in approachData.ts. -->

  <!-- ===== 5. THE SIX Cs ===== -->
  <Culture />

  <!-- ===== 6. MEET MARVALYN — the original homepage About block, restored
       verbatim. She closes the argument the page has already made. -->
  <About />

  <!-- ===== 7. CREDENTIALS AND COMPLIANCE ===== -->
  <section id="credentials" class="section" data-reveal>
    <div class="cred">
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        Licensed, insured, and accountable.
      </Heading>

      <div class="cred__grid">
        {
          credentials.map((item, i) => (
            <p class="pair cred__item" data-stagger style={`--i: ${i}`}>
              <strong>{item.label}</strong>
              {item.detail}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== 8. IN THE NEWS ===== -->
  <InTheNews />

  <!-- ===== 9. TESTIMONIALS — deliberately not built. Held until real
       quotes are collected with written permission (03-our-approach.md);
       never launch this section with placeholder or invented quotes. -->

  <!-- ===== 10. WORK WITH US — one section as of 2026-09-01; it was two before
       that and pushed the application form three screens down. -->
  <Careers />

  <!-- ===== 11. APPLY BAND — this page closes on the careers form instead of
       the sitewide family contact band (hideCTA on Layout above). The nav and
       footer "Request Care" links fall back to the homepage band here.
       No photo in this intro: the careers section directly above already
       carries one, and two in consecutive bands read as padding. -->
  <section id="apply" class="band band--cool apply" data-reveal>
    <div class="band__inner apply__inner">
      <div class="split split--gap-lg split--top">
        <!-- Same intro grammar as the contact band this replaces: heading,
             lead, photo plate, direct line. -->
        <div class="stack apply__intro">
          <Heading tag="h2" size="xxl" fontFamily="primary" weight="fw400" marginBottom="none">
            Apply, or just ask.
          </Heading>
          <p class="lead apply__lead">
            Send an application if you are ready, or tell us you are interested and we will call you
            to talk it through. Either way you hear back within one business day, from the owner.
          </p>
          <p class="meta--lg apply__direct">
            Prefer to talk? Call <a href={telHref}>{baseData.phone}</a> or email
            <a href={mailHref}>{baseData.email}</a>.
          </p>
          <p class="meta--lg apply__direct">
            Looking for care for someone in your family? <a href="/#contact">Request care here</a>.
          </p>
        </div>

        <CareerForm />
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  /* Emphasis without a callout frame — weight and colour only */
  .hero-strong {
    color: var(--qhc-navy-900);
    font-weight: 600;
  }

  // ---- 2. Comparison ----
  .comparison {
    &__header {
      --mb: 3rem;
      --w: 52rem;
    }
  }

  // ---- 7. Credentials ----
  .cred {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.75rem;
    max-width: 78rem;
    margin-inline: auto;
    padding: 3.5rem;
    background: var(--qhc-navy-050);
    border: 1px solid var(--qhc-navy-300);
    border-radius: var(--qhc-radius-lg);
    text-align: center;

    /* Five ruled columns on one row; the dividers drop before they can
       strand on a wrapped row — same rule as the credential band. */
    &__grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.75rem 0;
      width: 100%;
      padding-top: 2.5rem;
      border-top: 1px solid var(--qhc-hairline-cool);
      text-align: left;
    }

    &__item {
      padding: 0 1.5rem;

      &:first-child {
        padding-left: 0;
      }

      & + & {
        border-left: 1px solid var(--qhc-hairline-cool);
      }
    }

    @media (max-width: 1298px) {
      &__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.875rem 2.75rem;
      }

      &__item {
        padding: 0;

        & + & {
          border-left: 0;
        }
      }
    }

    @media (max-width: 990px) {
      padding: 2.5rem 2rem;
    }

    @media (max-width: 682px) {
      padding: 2rem 1.5rem;

      &__grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }

  // ---- 12. Apply band — the contact band's styles, one for one ----
  .apply {
    scroll-margin-top: 7.25rem;

    &__inner {
      --pad: 6rem;

      @media (max-width: 616px) {
        --pad: 3rem;
      }
    }

    /* Without the photo this column is far shorter than the form beside it, so
       it tracks the scroll instead of leaving a dead half-band — and the phone
       number stays on screen while someone is filling the form in. Same device
       the careers checklist column used before it was condensed away. */
    &__intro {
      --gap: 1.5rem;
      position: sticky;
      top: 8.5rem;

      @media (max-width: 1078px) {
        position: static;
      }
    }

    :global(.fs-xxl) {
      max-width: 20ch;
    }

    &__lead {
      --w: 46ch;
      line-height: 1.6;
    }

    &__direct {
      color: var(--qhc-slate-600);

      & + & {
        margin-top: -0.75rem;
      }
    }
  }
</style>
