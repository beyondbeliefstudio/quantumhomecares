---
/**
 * The shell every legal page sits in: privacy policy, terms, accessibility.
 *
 * These pages are long-form prose, which the rest of the site has no pattern
 * for — everywhere else copy arrives in short slotted blocks. So the body
 * styles live here rather than in global.scss, and they are the only place in
 * the codebase that styles bare h2/p/ul inside a slot.
 *
 * `hideCTA` is passed on every one of them. A care-request form under a
 * privacy policy reads as a sales pitch attached to a legal notice.
 *
 *   <LegalPage title="Privacy Policy" updated="September 8, 2026"
 *              pageTitle="…" description="…">
 *     <p class="lead">Opening paragraph…</p>
 *     <h2>A section</h2>
 *     <p>…</p>
 *   </LegalPage>
 */

// LAYOUT
import Layout from "@/layouts/Layout.astro";

// COMPONENTS
import Heading from "@/components/Heading.astro";

interface Props {
  title: string;
  updated: string;
  pageTitle: string;
  description: string;
}

const { title, updated, pageTitle, description } = Astro.props;
---

<Layout pageTitle={pageTitle} description={description} hideCTA>
  <section class="section legal">
    <div class="section-header section-header--left legal__head">
      <span class="eyebrow">Legal</span>

      <Heading tag="h1" size="xxl" fontFamily="primary" weight="fw400" marginBottom="none">
        {title}
      </Heading>

      <p class="meta legal__updated">Last updated {updated}</p>
    </div>

    <div class="legal__body">
      <slot />
    </div>
  </section>
</Layout>

<style lang="scss">
  .legal {
    padding-bottom: var(--qhc-section-gap);

    &__head {
      --mb: 2.5rem;
      max-width: 68ch;
    }

    &__updated {
      color: var(--qhc-slate-400);
    }

    /*
      One measure for the whole document. Legal prose is read in long runs, so
      the line length matters more here than anywhere else on the site.
    */
    &__body {
      max-width: 68ch;
      color: var(--qhc-ink-700);
      font-size: var(--qhc-size-label);
      line-height: 1.7;
    }
  }

  /* Slotted content is not scoped to this component, so it needs :global. */
  .legal__body :global(h2) {
    margin-top: 3rem;
    margin-bottom: 0.875rem;
    color: var(--qhc-navy-900);
    font-family: var(--qhc-font-display);
    font-size: var(--qhc-size-h2-sm);
    font-weight: 400;
    line-height: 1.2;
  }

  .legal__body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--qhc-navy-900);
    font-size: var(--qhc-size-label);
    font-weight: 600;
    line-height: 1.4;
  }

  .legal__body :global(h2:first-child),
  .legal__body :global(p:first-child) {
    margin-top: 0;
  }

  .legal__body :global(p) {
    margin: 0 0 1.125rem;
  }

  /* global.scss strips list markers sitewide; legal prose wants them back. */
  .legal__body :global(ul) {
    margin: 0 0 1.125rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal__body :global(ol) {
    margin: 0 0 1.125rem;
    padding-left: 1.25rem;
    list-style: decimal;
  }

  .legal__body :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .legal__body :global(li::marker) {
    color: var(--qhc-navy-300);
  }

  .legal__body :global(strong) {
    color: var(--qhc-navy-900);
    font-weight: 600;
  }

  /*
    A boxed aside for the one or two points on each page a reader genuinely
    needs to notice — the non-medical scope note, the emergency instruction.
  */
  .legal__body :global(.legal-callout) {
    margin: 0 0 1.125rem;
    padding: 1.25rem 1.375rem;
    background: var(--qhc-navy-050);
    border: 1px solid var(--qhc-navy-200);
    border-radius: var(--qhc-radius);
  }

  .legal__body :global(.legal-callout p:last-child) {
    margin-bottom: 0;
  }
</style>
