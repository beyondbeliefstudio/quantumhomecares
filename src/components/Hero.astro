---
// COMPONENTS
import Heading from "@/components/Heading.astro";
import Links from "@/components/Links.astro";

// HELPERS
import { Image } from "astro:assets";

// IMAGES
import primary from "@/assets/photos/hero-help.jpg";
---

<section id="hero" class="section hero">
  <!-- Blue glow bleeding off the top-right corner, behind the imagery -->
  <div class="hero__glow" aria-hidden="true" data-parallax="24"></div>

  <div class="split split--gap-sm">
    <div class="stack hero__copy" data-intro>
      <span class="eyebrow">In-Home Senior Care Across New Jersey</span>

      <Heading tag="h1" size="display" fontFamily="primary" weight="fw400" marginBottom="none">
        Home is where they want to be. We help them stay there.
      </Heading>

      <p class="lead lead--hero">
        Quantum Home Cares pairs everyday in-home support with hands-on medical advocacy, so aging
        at home stays safe and dignified and your family is not managing it alone.
      </p>

      <div class="btn-wrapper">
        <Links variant="primary" href="#contact" classes="lg">Request a Free Consultation</Links>
        <Links variant="outline" href="#how">See How It Works</Links>
      </div>
    </div>

    <div class="hero__media" data-intro-media>
      <div class="plate plate--lg hero__portrait" data-drift="5">
        <Image
          src={primary}
          alt="A caregiver walking arm in arm with a smiling senior woman"
          widths={[600, 1200]}
          sizes="(max-width: 980px) 92vw, 40vw"
        />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    padding-top: 5.25rem;
    padding-bottom: 2.5rem;
    /* The glow sits at z-index -1; isolation keeps that "behind the
       content" instead of "behind the section" — without a stacking
       context here a negative z-index sinks below the page itself. */
    isolation: isolate;

    &__glow {
      position: absolute;
      /* Behind the copy always. As a positioned element the glow painted
         above the static text column, which never showed while it stayed
         parked in the corner — the parallax drift moved it down over the
         copy, and on mobile the veil landed on the headline. */
      z-index: -1;
      top: -8.75rem;
      right: -11.25rem;
      width: 45rem;
      height: 45rem;
      border-radius: 50%;
      background: radial-gradient(
        circle at 50% 50%,
        var(--qhc-navy-100) 0%,
        rgba(214, 231, 246, 0.45) 46%,
        rgba(214, 231, 246, 0) 72%
      );
      pointer-events: none;
    }

    /*
      The glow is navy-100 — the same value as the pill's own fill. On desktop
      it sits top-right and the pill is over paper, but as the layout narrows
      the glow slides in behind it and the shape disappears into the backdrop.
      A hairline keeps the edge readable on either surface.
    */
    .eyebrow {
      border-color: var(--qhc-navy-300);
    }

    /* The hero animates on load rather than on scroll — GSAP cascades the
       copy stack element by element (see initHeroIntro), keyed off the
       data-intro / data-intro-media attributes in the markup above. */
    &__copy {
      --gap: 1.5rem;
    }

    &__media {
      position: relative;
    }

    /* The inset thumbnail was removed in review; the portrait now fills its
       column rather than being indented to make room for it. */
    &__portrait {
      aspect-ratio: 4 / 5;
    }
  }
</style>
