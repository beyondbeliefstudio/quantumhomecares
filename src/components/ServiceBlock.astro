---
/**
 * One service on /services, framed as a chapter card:
 *
 *   · The whole service is one bordered, heavily-rounded plate — photo fills
 *     one half inside the frame, text the other, sides alternating per
 *     service (`flip`).
 *   · The sequence numeral rides the photo on a glass chip — the one place
 *     glass is honest, over photography.
 *   · The photo drifts a few percent as the card crosses the viewport
 *     (CSS scroll-driven animation; browsers without animation-timeline, and
 *     anyone preferring reduced motion, get a still image).
 *   · "What this includes" is the card's footer strip: a cool wash with each
 *     item as a check chip, staggering in once the section reveals.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// TYPES
import type { ServiceDetail } from "@/data/servicesData";

interface Props {
  service: ServiceDetail;
  /** 1-based position in the sequence — rendered on the glass chip. */
  number: number;
  /** Every other card mirrors, photo on the right. */
  flip?: boolean;
}

const { service, number, flip = false } = Astro.props;
const numeral = String(number).padStart(2, "0");
---

<section id={service.id} class:list={["svc", flip && "svc--flip"]} data-reveal>
  <article class="svc__card">
    <div class="svc__split">
      <div class="svc__media">
        <Image
          src={service.photo}
          alt={service.photoAlt}
          widths={[800, 1400, 2000]}
          sizes="(max-width: 1078px) 92vw, 46vw"
        />
        <span class="svc__numeral" aria-hidden="true">{numeral}<em>/ 06</em></span>
      </div>

      <div class="svc__panel">
        <div class="stack svc__copy">
          <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
            {service.title}
          </Heading>

          <p class="svc__lead">{service.lead}</p>

          {service.body.map(paragraph => <p>{paragraph}</p>)}

          {
            service.definitions && (
              <dl class="svc__defs">
                {service.definitions.map(def => (
                  <div class="svc__def">
                    {/* The term runs into its own sentence — "Awake overnight
                        means…" — so dt and dd sit inline rather than stacked. */}
                    <dt>{def.term}</dt>
                    <dd>{def.copy}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {service.bodyAfter?.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>

    <div class="svc__footer">
      <span class="topic topic--accent">What this includes</span>
      <ul class="svc__chips">
        {
          service.includes.map((item, i) => (
            <li class="svc__chip" style={`--i: ${i}`}>
              <Icon name="check" class="svc__check" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</section>

<style lang="scss">
  .svc {
    max-width: var(--qhc-page-max);
    margin-inline: auto;
    margin-top: clamp(3rem, 6.6vw, 5rem);
    padding-inline: var(--qhc-gutter);
    /* The sticky header plus the services sub-nav rail — anchor jumps from
       the rail have to clear both. */
    scroll-margin-top: 12rem;

    &__card {
      overflow: hidden;
      background: var(--qhc-surface-raised);
      border: 1px solid var(--qhc-hairline);
      border-radius: var(--qhc-radius-lg);
    }

    &__split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 30rem;
    }

    &__media {
      position: relative;
      overflow: hidden;

      img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &--flip &__media {
      order: 2;
    }

    /*
      Scroll drift. The image is overscaled ~12% and slides through that
      headroom as the card crosses the viewport, so the crop never runs out
      of pixels. Scroll-driven animations ignore duration, so the global
      reduced-motion duration override cannot stop this one — hence the
      explicit no-preference gate on top of @supports.
    */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        &__media img {
          scale: 1.12;
          animation: svc-drift linear both;
          animation-timeline: view();
        }
      }
    }

    /* Glass over photography — the one honest home for the effect */
    &__numeral {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      display: inline-flex;
      align-items: baseline;
      gap: 0.375rem;
      padding: 0.5rem 1rem 0.4375rem;
      background: var(--qhc-glass-light);
      backdrop-filter: var(--qhc-glass-blur);
      -webkit-backdrop-filter: var(--qhc-glass-blur);
      border: var(--qhc-glass-edge);
      border-radius: var(--qhc-radius-pill);
      font-family: var(--qhc-font-display);
      font-size: 1.5rem;
      line-height: 1;
      color: var(--qhc-navy-900);

      em {
        font-family: var(--qhc-font-text);
        font-size: var(--qhc-size-eyebrow);
        font-style: normal;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--qhc-slate-600);
      }
    }

    &__panel {
      display: flex;
      align-items: center;
    }

    &__copy {
      --gap: 1.25rem;
      width: 100%;
      max-width: 58ch;
      margin-inline: auto;
      padding: clamp(2.5rem, 4.4vw, 4rem) clamp(1.75rem, 3.3vw, 3.25rem);
    }

    /* Sits between the h2 and the body: navy and a step up in size, so the
       one-line reason lands before the reader commits to four paragraphs. */
    &__lead {
      color: var(--qhc-navy-900);
      font-size: var(--qhc-size-body-m);
      font-weight: 500;
      line-height: 1.55;
    }

    &__defs {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-left: 1.125rem;
      border-left: 2px solid var(--qhc-navy-300);
    }

    &__def {
      font-size: var(--qhc-size-body-s);
      line-height: 1.6;
      color: var(--qhc-ink-700);

      dt {
        display: inline;
        color: var(--qhc-navy-900);
        font-weight: 600;
      }

      /* Cancels the UA margin so the definition continues the term's sentence */
      dd {
        display: inline;
        margin: 0;
      }
    }

    /* ---- Footer strip: the includes, as chips ---- */
    &__footer {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.625rem clamp(1.75rem, 3.3vw, 3.25rem) 1.875rem;
      background: var(--qhc-navy-050);
      border-top: 1px solid var(--qhc-hairline-cool);
    }

    &__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    &__chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5625rem 1rem 0.5625rem 0.875rem;
      background: var(--qhc-white);
      border: 1px solid var(--qhc-navy-200);
      border-radius: var(--qhc-radius-pill);
      font-size: var(--qhc-size-meta);
      line-height: 1.35;
      color: var(--qhc-ink-700);
      /* Staggered entrance — each chip trails the reveal by its index */
      transition:
        opacity 500ms var(--qhc-ease-out),
        transform 500ms var(--qhc-ease-out);
      transition-delay: calc(var(--i) * 55ms);
    }

    &__check {
      flex: 0 0 auto;
      width: 1rem;
      height: 1rem;
      color: var(--qhc-navy-700);
    }

    /* ---- Stacked ---- */
    @media (max-width: 1078px) {
      scroll-margin-top: 10rem;

      &__split {
        grid-template-columns: minmax(0, 1fr);
        min-height: 0;
      }

      /* Banner above the text — aspect box instead of a stretched half */
      &__media {
        order: 0;
        aspect-ratio: 16 / 10;

        img {
          position: static;
          inset: auto;
        }
      }

      &--flip &__media {
        order: 0;
      }

      &__panel {
        display: block;
      }

      &__copy {
        max-width: 100%;
      }
    }

    @media (max-width: 616px) {
      /* Card frame to the screen edges on phones — the gutter inside the
         card already provides the breathing room, and a frame within a
         gutter within a bezel is one border too many. */
      padding-inline: 0.625rem;

      &__media {
        aspect-ratio: 4 / 3;
      }
    }
  }

  /* Chips hold until the section's own reveal fires, then cascade. The
     hiding is gated on .js-reveal exactly like the global reveal styles, so
     no-JS readers always see the chips. */
  :global(.js-reveal) .svc:not(.is-visible) .svc__chip {
    opacity: 0;
    transform: translateY(0.5rem);
  }

  @keyframes svc-drift {
    from {
      transform: translateY(-3.5%);
    }
    to {
      transform: translateY(3.5%);
    }
  }
</style>
