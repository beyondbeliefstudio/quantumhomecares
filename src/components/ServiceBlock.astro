---
/**
 * One service on /services, framed as a chapter card:
 *
 *   · The whole service is one bordered, heavily-rounded plate — photo fills
 *     one half inside the frame, text the other, sides alternating per
 *     service (`flip`).
 *   · The photo drifts a few percent as the card crosses the viewport
 *     (data-drift → GSAP ScrollTrigger in app.js; anyone preferring
 *     reduced motion gets a still image).
 *   · "What this includes" is the card's footer strip: a cool wash with each
 *     item as a check chip, staggering in once the section reveals.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// TYPES
import type { ServiceDetail } from "@/data/servicesData";

interface Props {
  service: ServiceDetail;
  /** Every other card mirrors, photo on the right. */
  flip?: boolean;
}

const { service, flip = false } = Astro.props;
---

<section id={service.id} class:list={["svc", flip && "svc--flip"]} data-reveal>
  <article class="svc__card">
    <div class="svc__split">
      <div class="svc__media" data-drift="6">
        <Image
          src={service.photo}
          alt={service.photoAlt}
          widths={[800, 1400, 2000]}
          sizes="(max-width: 1078px) 92vw, 46vw"
        />
      </div>

      <div class="svc__panel">
        <div class="stack svc__copy">
          <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
            {service.title}
          </Heading>

          <p class="svc__lead">{service.lead}</p>

          {service.body.map(paragraph => <p>{paragraph}</p>)}

          {
            service.definitions && (
              <dl class="svc__defs">
                {service.definitions.map(def => (
                  <div class="svc__def">
                    {/* The term runs into its own sentence — "Awake overnight
                        means…" — so dt and dd sit inline rather than stacked. */}
                    <dt>{def.term}</dt>
                    <dd>{def.copy}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {service.bodyAfter?.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>

    <div class="svc__footer">
      <span class="topic topic--accent">What this includes</span>
      <ul class="svc__list">
        {
          service.includes.map((item, i) => (
            <li class="svc__item" data-stagger style={`--i: ${i}`}>
              <span class="svc__badge" aria-hidden="true">
                <Icon name="check" />
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</section>

<style lang="scss">
  .svc {
    max-width: var(--qhc-page-max);
    margin-inline: auto;
    margin-top: clamp(3rem, 6.6vw, 5rem);
    padding-inline: var(--qhc-gutter);
    /* The sticky header plus the services sub-nav rail — anchor jumps from
       the rail have to clear both. */
    scroll-margin-top: 12rem;

    &__card {
      overflow: hidden;
      background: var(--qhc-surface-raised);
      border: 1px solid var(--qhc-hairline);
      border-radius: var(--qhc-radius-lg);
    }

    &__split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 30rem;
    }

    &__media {
      position: relative;
      overflow: hidden;

      img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &--flip &__media {
      order: 2;
    }

    /* Scroll drift comes from data-drift (initPhotoDrift in app.js) —
       GSAP, not animation-timeline, so Safari and Firefox drift too. */

    &__panel {
      display: flex;
      align-items: center;
    }

    &__copy {
      --gap: 1.25rem;
      width: 100%;
      max-width: 58ch;
      margin-inline: auto;
      padding: clamp(2.5rem, 4.4vw, 4rem) clamp(1.75rem, 3.3vw, 3.25rem);
    }

    /* Sits between the h2 and the body: navy and a step up in size, so the
       one-line reason lands before the reader commits to four paragraphs. */
    &__lead {
      color: var(--qhc-navy-900);
      font-size: var(--qhc-size-body-m);
      font-weight: 500;
      line-height: 1.55;
    }

    /* No accent bar — that callout style was retired sitewide. The inline
       bold terms carry the structure on their own. */
    &__defs {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    &__def {
      font-size: var(--qhc-size-body-s);
      line-height: 1.6;
      color: var(--qhc-ink-700);

      dt {
        display: inline;
        color: var(--qhc-navy-900);
        font-weight: 600;
      }

      /* Cancels the UA margin so the definition continues the term's sentence */
      dd {
        display: inline;
        margin: 0;
      }
    }

    /* ---- Footer strip: the includes, as chips ---- */
    &__footer {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.625rem clamp(1.75rem, 3.3vw, 3.25rem) 1.875rem;
      background: var(--qhc-navy-050);
      border-top: 1px solid var(--qhc-hairline-cool);
    }

    /*
      Two quiet columns, no boxes — the earlier pill chips put nine bordered
      shapes in the strip and it read as clutter. Alignment carries the
      structure now; the only ornament is the small tinted badge.
    */
    /*
      Multi-column, not grid: columns fill top-to-bottom and balance
      themselves, so a two-line item just pushes its own column down. The
      old row-major grid synced row heights across columns, and every
      wrapped line left a hole beside it. 24rem is the same column floor
      the grid used — below it the list collapses to one column.
    */
    &__list {
      columns: 24rem 2;
      column-gap: 3.5rem;
      list-style: none;
      /* Swallows the last row's item margin so the footer's own padding
         still sets the bottom spacing, like the grid's gap did. */
      margin-bottom: -1rem;
    }

    &__item {
      display: grid;
      grid-template-columns: 1.5rem 1fr;
      gap: 0.875rem;
      align-items: start;
      /* Rhythm between items — column boxes ignore row gap */
      margin-bottom: 1rem;
      /* Never split one item's two lines across the column break */
      break-inside: avoid;
      font-size: var(--qhc-size-label);
      line-height: 1.5;
      color: var(--qhc-ink-700);
    }

    &__badge {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      margin-top: 0.0625rem;
      background: var(--qhc-navy-100);
      border-radius: var(--qhc-radius-circle);
      color: var(--qhc-navy-800);

      :global(svg) {
        width: 0.875rem;
        height: 0.875rem;
      }
    }

    /* ---- Stacked ---- */
    @media (max-width: 1078px) {
      scroll-margin-top: 10rem;

      &__split {
        grid-template-columns: minmax(0, 1fr);
        min-height: 0;
      }

      /* Banner above the text — aspect box instead of a stretched half */
      &__media {
        order: 0;
        aspect-ratio: 16 / 10;

        img {
          position: static;
          inset: auto;
        }
      }

      &--flip &__media {
        order: 0;
      }

      &__panel {
        display: block;
      }

      &__copy {
        max-width: 100%;
      }
    }

    @media (max-width: 616px) {
      /* Card frame to the screen edges on phones — the gutter inside the
         card already provides the breathing room, and a frame within a
         gutter within a bezel is one border too many. */
      padding-inline: 0.625rem;

      &__media {
        aspect-ratio: 4 / 3;
      }
    }
  }

  /* The list items cascade via the global [data-stagger] utility. */
</style>
