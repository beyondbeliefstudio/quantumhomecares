---
// COMPONENTS
import Heading from "@/components/Heading.astro";

// DATA
import { referralPoints } from "@/data/homeData";
---

<!--
  The one B2B moment on the page, so it gets its own plane: the navy-050 /
  navy-300 "Quantum" surface from the comparison table, framed as a module.
-->
<section id="professionals" class="section" data-reveal>
  <div class="pro">
    <div class="stack pro__intro">
      <span class="eyebrow eyebrow--band">For Care Professionals</span>
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        A referral partner who closes the loop.
      </Heading>
    </div>

    <!-- Ruled columns, credential-band rhythm: dividers between items, never stranded on a wrap -->
    <div class="pro__points">
      {
        referralPoints.map(point => (
          <div class="stack pro__point">
            <Heading tag="h3" size="xxs" fontFamily="secondary" weight="fw600" marginBottom="none">
              {point.title}
            </Heading>
            <p>{point.copy}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .pro {
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding: 3.5rem;
    background: var(--qhc-navy-050);
    border: 1px solid var(--qhc-navy-300);
    border-radius: var(--qhc-radius-lg);

    /*
      Centered intro: eyebrow + heading.

      align-items: center is doing the real work. .stack only sets the column
      direction, so align-items defaults to stretch — and .eyebrow is
      width: fit-content, which cannot stretch, so it fell to flex-start and
      sat on the heading's left edge instead of centred under it. text-align
      alone does not fix that: the pill is a flex item, not inline text.
    */
    &__intro {
      --gap: 1.25rem;
      align-items: center;
      text-align: center;
    }

    &__points {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem 0;
      padding-top: 2.5rem;
      border-top: 1px solid var(--qhc-hairline-cool);
    }

    &__point {
      --gap: 0.5rem;
      padding: 0 1.625rem;

      &:first-child {
        padding-left: 0;
      }

      & + & {
        border-left: 1px solid var(--qhc-hairline-cool);
      }
    }

    @media (max-width: 1298px) {
      &__points {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.875rem 2.75rem;
      }

      &__point {
        padding: 0;

        & + & {
          border-left: 0;
        }
      }
    }

    @media (max-width: 990px) {
      padding: 2.5rem 2rem;
    }

    @media (max-width: 682px) {
      padding: 2rem 1.5rem;

      &__points {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
