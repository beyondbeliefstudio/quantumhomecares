---
/**
 * Homepage B2B routing signal. Condensed per buildout-notes/01-home.md — the
 * four detail cards moved to /for-professionals (see ReferralPoints.astro).
 *
 * Tone note from the content brief: this addresses a different audience than
 * the rest of the page and should read efficient rather than warm. It is a
 * routing signal, not a pitch — which is why it stays one paragraph.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";
import Links from "@/components/Links.astro";

// HELPERS
import { Icon } from "astro-icon/components";
---

<!--
  The one B2B moment on the page, so it gets its own plane: the navy-050 /
  navy-300 "Quantum" surface from the comparison table, framed as a module.
-->
<section id="professionals" class="section" data-reveal>
  <div class="pro">
    <div class="stack pro__intro">
      <span class="eyebrow eyebrow--band">For Care Professionals</span>
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        A referral partner who closes the loop.
      </Heading>
      <p class="lead pro__lead">
        Discharge planners, social workers, case managers, and elder law attorneys work with us
        because referrals get acknowledged the same business day and homes get staffed within days,
        not weeks.
      </p>
      <Links variant="inline" href="/for-professionals">
        See how referrals work
        <Icon name="arrow-right" aria-hidden="true" />
      </Links>
    </div>
  </div>
</section>

<style lang="scss">
  .pro {
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    padding: 3.5rem;
    background: var(--qhc-navy-050);
    border: 1px solid var(--qhc-navy-300);
    border-radius: var(--qhc-radius-lg);

    /*
      Centered intro: eyebrow + heading + lead + link.

      align-items: center is doing the real work. .stack only sets the column
      direction, so align-items defaults to stretch — and .eyebrow is
      width: fit-content, which cannot stretch, so it fell to flex-start and
      sat on the heading's left edge instead of centred under it. text-align
      alone does not fix that: the pill is a flex item, not inline text.
    */
    &__intro {
      --gap: 1.25rem;
      align-items: center;
      text-align: center;
    }

    &__lead {
      --w: 62ch;
    }

    @media (max-width: 990px) {
      padding: 2.5rem 2rem;
    }

    @media (max-width: 682px) {
      padding: 2rem 1.5rem;
    }
  }
</style>
