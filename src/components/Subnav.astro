---
/**
 * Sticky glass pill rail for long in-page navigation — one anchor per
 * section, riding just below the site header. app.js's scrollspy
 * (initScrollSpy) marks whichever section is currently on screen.
 *
 * Generalized from the /services rail so any chaptered page can carry one:
 *
 *   <Subnav ariaLabel="Services on this page"
 *           items={things.map(t => ({ href: `#${t.id}`, label: t.short }))} />
 *
 * Overlaps the hero's bottom seam by half its height, so the rail reads as a
 * fixture of the page rather than the first line of content. Sections it
 * points at need scroll-margin-top for the header + rail stack (~12rem).
 */

interface Props {
  items: { href: string; label: string }[];
  ariaLabel: string;
}

const { items, ariaLabel } = Astro.props;
---

<nav class="subnav" aria-label={ariaLabel} data-subnav>
  <div class="subnav__rail">
    {items.map(item => <a href={item.href} class="subnav__pill">{item.label}</a>)}
  </div>
</nav>

<style lang="scss">
  .subnav {
    /* Below the header (z 40), above everything on the page */
    position: sticky;
    top: calc(var(--qhc-header-h) + 0.75rem);
    z-index: 30;
    display: flex;
    justify-content: center;
    margin-top: -1.625rem;
    padding-inline: var(--qhc-gutter);
    pointer-events: none; /* the bar, not the whole strip, takes clicks */
  }

  .subnav__rail {
    display: flex;
    gap: 0.25rem;
    max-width: 100%;
    padding: 0.375rem;
    overflow-x: auto;
    background: var(--qhc-glass-light);
    backdrop-filter: var(--qhc-glass-blur);
    -webkit-backdrop-filter: var(--qhc-glass-blur);
    border: var(--qhc-glass-edge);
    border-radius: var(--qhc-radius-pill);
    pointer-events: auto;
    /* Rail scrolls sideways on narrow screens; no scrollbar chrome */
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .subnav__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    flex: 0 0 auto;
    padding: 0.5rem 1rem;
    border-radius: var(--qhc-radius-pill);
    color: var(--qhc-navy-800);
    font-size: var(--qhc-size-meta);
    font-weight: 600;
    text-decoration: none;
    transition:
      background var(--qhc-duration-base) var(--qhc-ease-out),
      color var(--qhc-duration-base) var(--qhc-ease-out);

    &:hover,
    &:focus-visible {
      background: var(--qhc-navy-100);
      color: var(--qhc-navy-900);
    }
  }

  /* Scrollspy state — set by initScrollSpy in app.js */
  .subnav__pill.is-active {
    background: var(--qhc-navy-700);
    color: var(--qhc-white);
  }
</style>
