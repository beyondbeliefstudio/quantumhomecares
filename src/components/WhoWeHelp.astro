---
/**
 * The four moments families reach out — /our-approach section 5.
 * Cards cascade in behind the section reveal; the icon circle warms on hover.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";

// HELPERS
import { Icon } from "astro-icon/components";

// DATA
import { moments } from "@/data/approachData";
---

<section id="who" class="section" data-reveal>
  <div class="section-header who__header">
    <span class="eyebrow">Who We Help</span>
    <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
      Families reach us at one of four moments.
    </Heading>
    <p class="lead who__lead">
      Requests come from all directions. The person who needs care, a spouse, a son or daughter, a
      friend, a social worker, a discharge planner. We welcome all of them.
    </p>
  </div>

  <div class="auto-grid auto-grid--four who__grid">
    {
      moments.map((item, i) => (
        <article class="card who__card" data-stagger style={`--i: ${i}`}>
          <span class="icon-circle">
            <Icon name={item.icon} aria-hidden="true" />
          </span>
          <Heading tag="h3" size="xs" fontFamily="secondary" weight="fw600" marginBottom="none">
            {item.title}
          </Heading>
          <p>{item.copy}</p>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  .who {
    &__header {
      --w: 72ch;
      --mb: 3.25rem;
    }

    &__lead {
      --w: 62ch;
    }

    &__card {
      --gap: 0.75rem;
      transition:
        border-color var(--qhc-duration-base) var(--qhc-ease-out),
        opacity 600ms var(--qhc-ease-out),
        transform 600ms var(--qhc-ease-out);

      /* Micro: the card's edge and its icon warm together. No lift, no shadow. */
      .icon-circle {
        transition:
          background var(--qhc-duration-base) var(--qhc-ease-out),
          border-color var(--qhc-duration-base) var(--qhc-ease-out);
      }

      &:hover {
        border-color: var(--qhc-navy-300);

        .icon-circle {
          background: var(--qhc-navy-200);
          border-color: var(--qhc-navy-300);
        }
      }
    }
  }
</style>
