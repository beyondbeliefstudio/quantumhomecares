---
// COMPONENTS
import Heading from "@/components/Heading.astro";

// HELPERS
import { Icon } from "astro-icon/components";

// DATA
import { whoWeHelp } from "@/data/homeData";
---

<section id="who" class="section" data-reveal>
  <div class="section-header who__header">
    <span class="eyebrow">Who We Help</span>
    <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
      Families usually reach us at one of four moments.
    </Heading>
    <p class="lead who__lead">
      Sometimes the senior calls us directly. More often it is an adult child, a spouse, or a
      discharge planner calling on their behalf. All of it is welcome.
    </p>
  </div>

  <div class="auto-grid who__grid">
    {
      whoWeHelp.map(item => (
        <article class="card who__card">
          <span class="icon-circle">
            <Icon name={item.icon} aria-hidden="true" />
          </span>
          <Heading tag="h3" size="xs" fontFamily="secondary" weight="fw600" marginBottom="none">
            {item.title}
          </Heading>
          <p>{item.copy}</p>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  .who {
    &__header {
      --w: 72ch;
      --mb: 3.25rem;
    }

    &__lead {
      --w: 62ch;
    }

    &__grid {
      --min: 280px;
    }

    &__card {
      --gap: 0.75rem;
    }
  }
</style>
