---
/**
 * Homepage services snapshot. Four one-line cards per
 * buildout-notes/01-home.md — the six full descriptions, including
 * Transportation and Companionship, live on /services.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";
import Links from "@/components/Links.astro";

// HELPERS
import { Icon } from "astro-icon/components";

// DATA
import { services } from "@/data/homeData";
---

<section id="services" class="band band--down" data-reveal>
  <div class="band__inner">
    <div class="section-header">
      <span class="eyebrow eyebrow--band">What We Do</span>
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        Complete support, built around one person.
      </Heading>
      <p class="lead">
        Every family arrives with a different situation. We build a care plan around what your
        loved one actually needs, then adjust it as things change.
      </p>
    </div>

    <!-- Four across, pairs at tablet, stacked on phones — never 3+1 -->
    <div class="auto-grid auto-grid--four services__grid">
      {
        services.map(s => (
          <article class="card">
            <span class="icon-circle">
              <Icon name={s.icon} aria-hidden="true" />
            </span>
            <Heading tag="h3" size="s" fontFamily="secondary" weight="fw600" marginBottom="none">
              {s.title}
            </Heading>
            <p>{s.copy}</p>
          </article>
        ))
      }
    </div>

    <div class="btn-wrapper btn-wrapper--center services__more">
      <Links variant="inline" href="/services">
        See everything we provide
        <Icon name="arrow-right" aria-hidden="true" />
      </Links>
    </div>
  </div>
</section>

<style lang="scss">
  .services {
    &__more {
      margin-top: 3rem;
    }
  }
</style>
