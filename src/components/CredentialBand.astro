---
// DATA
import { credentials } from "@/data/homeData";
---

<!-- Brand-blue plane. Dividers sit between items, never at an edge. -->
<section id="trust" class="credentials" data-reveal>
  <div class="credentials__inner">
    <div class="credentials__grid">
      {
        credentials.map(c => (
          <p class="credentials__item" data-stagger>
            <strong>{c.label}</strong>
            {c.detail}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .credentials {
    margin-top: 4.5rem;
    /* The action blue, same fill as the primary button */
    background: var(--qhc-navy-700);

    &__inner {
      max-width: var(--qhc-page-max);
      margin-inline: auto;
      padding: 3.25rem var(--qhc-gutter);
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.75rem 0;
    }

    &__item {
      padding: 0 1.625rem;
      /* 0.92, not the 0.82 this carried on navy-900: the plane is lighter now,
         and 82% white over navy-700 lands at ~4.2:1 — under AA for body text.
         0.92 clears it at ~4.8:1. Dividers step up for the same reason. */
      color: rgba(255, 255, 255, 0.92);
      font-size: var(--qhc-size-label);
      line-height: 1.5;
      border-left: 1px solid rgba(255, 255, 255, 0.38);

      &:first-child {
        padding-left: 0;
        border-left: 0;
      }

      strong {
        display: block;
        color: var(--qhc-white);
        font-weight: 600;
      }
    }

    /* Drop the dividers before they can strand on a wrapped row */
    @media (max-width: 1298px) {
      &__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.875rem 2.75rem;
      }

      &__item {
        padding: 0;
        border-left: 0;
      }
    }

    /* Stacked — the divider comes back, turned horizontal. One column means
       there is no wrapped row for it to strand on, so the rule between items
       is unambiguous again. Padding does the spacing instead of the grid gap,
       otherwise the line would float in the middle of the gap. */
    @media (max-width: 682px) {
      &__grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
      }

      &__item {
        padding-block: 1.5rem;
      }

      /* Never at an edge — see the note at the top of the file */
      &__item + &__item {
        border-top: 1px solid rgba(255, 255, 255, 0.38);
      }

      &__item:first-child {
        padding-top: 0;
      }

      &__item:last-child {
        padding-bottom: 0;
      }
    }
  }
</style>
