---
/**
 * Press and podcast coverage — one card per entry in `press`, newest first.
 *
 * Each card is a whole link out to the source. The two things that vary by
 * entry are the cue verb (read an article, listen to an episode) and whether
 * the media half holds photography or cover art; everything else is the same
 * object however long the list gets.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// DATA
import { press } from "@/data/approachData";

// Article or episode — the card says which, in the chip's verb and the cue.
const cue = { article: "Read the article", podcast: "Listen to the episode" };
const verb = { article: "read on", podcast: "listen on" };
---

<section id="news" class="section" data-reveal>
  <div class="section-header news__header">
    <span class="eyebrow">In the News</span>
    <Heading tag="h2" size="l" fontFamily="primary" weight="fw400" marginBottom="none">
      Where we've been featured.
    </Heading>
  </div>

  <!-- The whole card is the link. Hover reads through the photo and headline
       rather than the card shell — see the note above the styles below. -->
  <div class="news__list">
    {
      press.map(item => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener"
          class="card news__card"
          aria-label={`${item.headline} — ${verb[item.kind]} ${item.source}`}
          data-stagger
        >
          <div class:list={["news__media", item.isLogo && "news__media--logo"]}>
            <Image src={item.image} alt={item.imageAlt} width={900} widths={[450, 900]} />
          </div>

          <div class="news__body">
            {/* .eyebrow is width: fit-content, so it does not stretch in this
                flex column without a wrapper around it. */}
            <span class="eyebrow eyebrow--info">{item.source}</span>

            <Heading
              tag="h3"
              size="m"
              fontFamily="primary"
              weight="fw400"
              marginBottom="none"
              class="news__headline"
            >
              {item.headline}
            </Heading>

            <p class="news__dek">{item.dek}</p>

            <span class="btn inline news__cue">
              {cue[item.kind]}
              <Icon name="arrow-right" aria-hidden="true" />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style lang="scss">
  .news {
    &__header {
      --w: 62ch;
      --mb: 2.75rem;
    }

    &__list {
      display: grid;
      gap: 1.5rem;
    }

    /* Reuses .card for the chrome, then overrides the flow to a 5/7 split */
    &__card {
      --pad: 0;
      display: grid;
      grid-template-columns: 5fr 7fr;
      align-items: stretch;
      overflow: hidden;
      border-radius: var(--qhc-radius-lg);
      text-decoration: none;

      @media (max-width: 836px) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    &__media {
      position: relative;
      /* Clips its own image zoom without touching the card's rounded corners */
      overflow: hidden;
      min-height: 21.25rem;

      img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--qhc-duration-enter) var(--qhc-ease-out);
      }

      @media (max-width: 836px) {
        min-height: 16.25rem;
      }
    }

    /*
      Cover art, not photography. A square logo cropped to fill loses its own
      edges — worse on mobile, where this half goes wide and short — so it is
      contained on a plate instead. The plate is white like the card, so a
      hairline carries the division the photo edge carries on the other card.
    */
    &__media--logo {
      background: var(--qhc-white);
      border-right: 1px solid var(--qhc-rule);

      img {
        position: absolute;
        inset: 0;
        padding: clamp(1.75rem, 4vw, 3rem);
        object-fit: contain;
      }

      @media (max-width: 836px) {
        border-right: 0;
        border-bottom: 1px solid var(--qhc-rule);
      }
    }

    &__body {
      display: flex;
      flex-direction: column;
      gap: 1.125rem;
      padding: 2.75rem 3rem;

      @media (max-width: 616px) {
        padding: 1.75rem 1.5rem;
      }
    }

    &__dek {
      max-width: 52ch;
      line-height: 1.6;
    }

    /* Pinned to the bottom of the panel however tall the dek runs */
    &__cue {
      margin-top: auto;
    }

    /*
      The whole card is the link, so hover reads through the photo and the
      headline rather than the card shell: the cover image eases into a slow,
      contained zoom and the headline shifts to navy-800 — the arrow was already
      doing this same job in miniature. No lift, no border change, and
      nothing shifts position.
    */
    &__card :global(.news__headline) {
      transition: color var(--qhc-duration-base) var(--qhc-ease-out);
    }

    &__card:hover &__media :global(img),
    &__card:focus-visible &__media :global(img) {
      transform: scale(1.05);
    }

    &__card:hover :global(.news__headline),
    &__card:focus-visible :global(.news__headline) {
      color: var(--qhc-navy-800);
    }

    &__card:hover &__cue :global(svg),
    &__card:focus-visible &__cue :global(svg) {
      transform: translateX(0.25rem);
    }
  }
</style>
