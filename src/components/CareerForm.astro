---
/**
 * The caregiver application form — a THIRD Netlify form, separate from the
 * family "contact" and professional "referral" forms so hiring inquiries land
 * in their own bucket and never mix with care requests.
 *
 * Cut to seven fields on 2026-09-01. It previously opened with an apply/enquire
 * intent switch and asked for experience, availability and work area as well.
 * That is a screening interview asked of someone who has not spoken to anyone
 * yet, and the same answers come out of the first phone call anyway. Name,
 * contact, the role, an optional résumé and an open box is enough to start a
 * conversation; Marvalyn gathers the rest when she calls.
 *
 * Résumé upload is optional (Netlify accepts files on multipart forms, 8 MB
 * cap per file).
 */

// COMPONENTS
import Buttons from "@/components/Buttons.astro";

// DATA
import { careerRoles } from "@/data/approachData";

const source = Astro.url.pathname;
---

<form
  class="form-panel"
  name="careers"
  method="POST"
  action="/submit-application"
  enctype="multipart/form-data"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <!-- Honeypot — hidden from users, visible to bots -->
  <p class="hidden">
    <label>
      Don't fill this out:
      <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <input type="hidden" name="source" value={source} />

  <p class="eyebrow">Work with us</p>

  <p class="meta form-legend">
    <span class="required" aria-hidden="true">*</span> Required.
  </p>

  <div class="form-row">
    <div class="form-group">
      <label for="job-first-name">
        First name<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="job-first-name" name="firstName" type="text" autocomplete="given-name" required />
    </div>
    <div class="form-group">
      <label for="job-last-name">
        Last name<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="job-last-name" name="lastName" type="text" autocomplete="family-name" required />
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="job-phone">
        Phone<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="job-phone" name="phone" type="tel" autocomplete="tel" required />
    </div>
    <div class="form-group">
      <label for="job-email">
        Email<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="job-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  <div class="form-group">
    <label for="job-role">
      Role you are interested in<span class="required" aria-hidden="true">*</span>
    </label>
    <select id="job-role" name="role" required>
      <option value="" disabled selected>Select one</option>
      {careerRoles.map(option => <option value={option}>{option}</option>)}
    </select>
  </div>

  <div class="form-group">
    <label for="job-resume">
      Résumé <span class="form-optional">(optional — PDF or Word, up to 8 MB)</span>
    </label>
    <input
      id="job-resume"
      class="file"
      name="resume"
      type="file"
      accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    />
  </div>

  <div class="form-group">
    <label for="job-notes">
      Tell us a little about yourself <span class="form-optional">(optional)</span>
    </label>
    <textarea id="job-notes" name="notes" rows="4"></textarea>
  </div>

  <Buttons variant="primary" classes="full">Send Application</Buttons>

  <p class="meta">
    We respond within one business day. Every caregiver is screened and background checked before
    working with a client. Quantum Home Cares is an equal opportunity employer.
  </p>
</form>

<style lang="scss">
  /* Same treatment as the contact form's optional marker */
  .form-optional {
    color: var(--qhc-slate-600);
    font-weight: 400;
  }

  // ---- Résumé upload ----
  // The global input rule (fixed height, zero vertical padding) is built for
  // text fields; a file input needs room for its button.
  .file {
    padding: 0.5rem;
    color: var(--qhc-slate-600);
    font-size: var(--qhc-size-meta);
    line-height: 1.4;
    cursor: pointer;

    &::file-selector-button {
      margin-right: 0.875rem;
      padding: 0.5rem 1rem;
      background: var(--qhc-navy-100);
      border: 1px solid var(--qhc-navy-200);
      border-radius: var(--qhc-radius-pill);
      color: var(--qhc-navy-800);
      font-family: inherit;
      font-size: var(--qhc-size-meta);
      font-weight: 600;
      cursor: pointer;
      transition:
        background var(--qhc-duration-fast) var(--qhc-ease-out),
        border-color var(--qhc-duration-fast) var(--qhc-ease-out);
    }

    &:hover::file-selector-button {
      background: var(--qhc-navy-200);
      border-color: var(--qhc-navy-300);
    }
  }
</style>
