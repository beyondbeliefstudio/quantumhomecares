---
// COMPONENTS
import Heading from "@/components/Heading.astro";

// DATA
import { steps } from "@/data/homeData";
---

<!--
  A process, drawn as one: three markers on a connecting line, read left to
  right. Markers follow the tinted-band chip rule — white with a navy-300
  edge — so they hold against the wash.
-->
<!-- --flush: this band sits directly under the full-bleed quote banner -->
<section id="how" class="band band--up band--flush" data-reveal>
  <div class="band__inner">
    <div class="section-header how__header">
      <span class="eyebrow eyebrow--band">Getting Started</span>
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        From first message to first day of care.
      </Heading>
    </div>

    <ol class="how__steps">
      {
        steps.map((step, i) => (
          <li class="how__step" data-stagger style={`--i: ${i}`}>
            <span class="how__marker" aria-hidden="true">{i + 1}</span>
            <div class="stack how__body">
              <Heading tag="h3" size="xs" fontFamily="secondary" weight="fw600" marginBottom="none">
                {step.title}
              </Heading>
              <p>{step.copy}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style lang="scss">
  .how {
    &__header {
      --mb: 3.5rem;
    }

    &__steps {
      --gap: 2.5rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap);
      list-style: none;
    }

    &__step {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.125rem;
      text-align: center;

      /* Connector — this marker's edge to the next, across the gap.
         42px = marker radius (28) + clearance (14). */
      &:not(:last-child)::before {
        content: "";
        position: absolute;
        top: 1.75rem;
        left: calc(50% + 2.625rem);
        right: calc(-50% - var(--gap) + 2.625rem);
        height: 1px;
        background: var(--qhc-navy-300);
      }
    }

    /*
      The connectors draw left→right once the section reveals, trailing the
      steps' own cascade. Hidden state is gated on .js-reveal exactly like
      the global reveal rules, so a no-JS reader sees them already drawn.
      The delay clears the last step's stagger (2 × 70ms) plus a beat.
    */
    @media (prefers-reduced-motion: no-preference) {
      &__step:not(:last-child)::before {
        transform-origin: 0 50%;
        transition: transform 900ms var(--qhc-ease-out) 300ms;
      }

      :global(.js-reveal) #how:not(.is-visible) &__step:not(:last-child)::before {
        transform: scaleX(0);
      }
    }

    &__marker {
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      background: var(--qhc-white);
      border: 1px solid var(--qhc-navy-300);
      border-radius: var(--qhc-radius-circle);
      color: var(--qhc-navy-800);
      /* Sans numerals sitewide — the serif figures were retired in review */
      font-family: var(--qhc-font-text);
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1;
    }

    &__body {
      --gap: 0.5rem;
    }

    @media (max-width: 990px) {
      &__steps {
        grid-template-columns: minmax(0, 1fr);
        gap: 2.25rem;
      }

      /* Stacked — same centred column, connectors off */
      &__step:not(:last-child)::before {
        content: none;
      }
    }
  }
</style>
