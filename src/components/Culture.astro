---
/**
 * The six Cs — /our-approach section 7. Six word cards on the tinted band,
 * cascading in; each card leads with its C set large in Gambetta.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";

// DATA
import { culture } from "@/data/approachData";
---

<section id="six-cs" class="band band--down" data-reveal>
  <div class="band__inner">
    <div class="section-header culture__header">
      <span class="eyebrow eyebrow--band">Our Culture</span>
      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        Our operations and culture are anchored in the six Cs of Caregiving.
      </Heading>
    </div>

    <div class="auto-grid culture__grid">
      {
        culture.map((item, i) => (
          <div class="card culture__card" data-stagger style={`--i: ${i}`}>
            <Heading tag="h3" size="statement" fontFamily="primary" weight="fw400" marginBottom="none">
              {item.word}
            </Heading>
            <span class="culture__line">{item.copy}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .culture {
    &__header {
      --w: 60ch;
      --mb: 3rem;
    }

    &__grid {
      --min: 18.75rem;
      --gap: 1.25rem;
    }

    &__card {
      --pad: 1.75rem 1.75rem 1.625rem;
      --gap: 0.5rem;
      transition:
        border-color var(--qhc-duration-base) var(--qhc-ease-out),
        opacity 600ms var(--qhc-ease-out),
        transform 600ms var(--qhc-ease-out);

      /* Micro: the word deepens and the frame cools — nothing moves. */
      :global(h3) {
        color: var(--qhc-navy-700);
        transition: color var(--qhc-duration-base) var(--qhc-ease-out);
      }

      &:hover {
        border-color: var(--qhc-navy-300);

        :global(h3) {
          color: var(--qhc-navy-900);
        }
      }
    }

    &__line {
      color: var(--qhc-ink-700);
      font-size: var(--qhc-size-label);
    }
  }
</style>
