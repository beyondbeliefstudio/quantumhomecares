---
// COMPONENTS
import Buttons from "@/components/Buttons.astro";

// DATA
import { serviceDetails } from "@/data/servicesData";

// The form renders on every page now, so the source tag comes from the URL
// rather than a hardcoded "homepage-contact" — submissions say where they
// actually came from.
const source = Astro.url.pathname;

// Sourced from the services page rather than retyped, so the options a visitor
// picks from cannot drift away from the services the site actually describes.
// The value is sent verbatim to AxisCare, where it becomes the email subject
// line and the first line of the lead note — free text would put a paragraph
// in both.
const helpTypes = [...serviceDetails.map(service => service.title), "Not sure yet"];
---

<form
  class="form-panel"
  name="contact"
  method="POST"
  action="/submit-contact/"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <!-- Honeypot — hidden from users, visible to bots -->
  <p class="hidden">
    <label>
      Don't fill this out:
      <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <!-- Tags the submission with the page it came from -->
  <input type="hidden" name="source" value={source} />

  <p class="eyebrow">Request a free consultation</p>

  <!--
    Sits above the first input so it is read before them. This used to say "All
    fields are required" — it no longer can, because the last field is optional,
    so the asterisks have to be what carries the distinction.
  -->
  <p class="meta form-legend">
    <span class="required" aria-hidden="true">*</span> Required.
  </p>

  <div class="form-row">
    <div class="form-group">
      <label for="first-name">
        First name<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="first-name" name="firstName" type="text" autocomplete="given-name" required />
    </div>
    <div class="form-group">
      <label for="last-name">
        Last name<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="last-name" name="lastName" type="text" autocomplete="family-name" required />
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="phone">
        Phone<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" required />
    </div>
    <div class="form-group">
      <label for="email">
        Email<span class="required" aria-hidden="true">*</span>
      </label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  <div class="form-group">
    <label for="help-type">
      What kind of help are you looking for?<span class="required" aria-hidden="true">*</span>
    </label>
    <select id="help-type" name="helpType" required>
      <option value="">Choose one</option>
      {helpTypes.map(option => <option value={option}>{option}</option>)}
    </select>
  </div>

  <div class="form-group">
    <label for="notes">
      Anything else you want us to know <span class="form-optional">(optional)</span>
    </label>
    <textarea id="notes" name="notes" rows="3"></textarea>
  </div>

  <Buttons variant="primary" classes="full">Send Request</Buttons>

  <p class="meta">
    We respond within one business day. Please leave out medical details — we will gather what we
    need when we speak.
  </p>
</form>

<style lang="scss">
  /* Sheds the label's 600 weight and ink colour so "(optional)" reads as an
     aside to the question rather than part of it. */
  .form-optional {
    color: var(--qhc-slate-600);
    font-weight: 400;
  }
</style>
