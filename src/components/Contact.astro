---
// COMPONENTS
import Heading from "@/components/Heading.astro";
import ContactForm from "@/components/ContactForm.astro";

// HELPERS
import { Image } from "astro:assets";

// DATA
import { baseData, telHref, mailHref } from "@/data/siteData";

// IMAGES
import portrait from "@/assets/photos/contact.jpg";

// PROPS
/**
 * Rendered on every page by Layout.astro. Pages can retitle the band so the
 * ask fits where the reader just was — /services closes with "Not sure what
 * your family needs?" — while the form itself stays identical sitewide.
 */
interface Props {
  title?: string;
  lead?: string;
}

const {
  title = "Tell us about your situation.",
  lead = "Send us the situation and we will respond within one business day. Families, seniors, and referring professionals all use this form. It costs nothing to ask, and there is nothing to sign.",
} = Astro.props;
---

<section id="contact" class="band band--cool contact" data-reveal>
  <div class="band__inner contact__inner">
    <div class="split split--gap-lg split--top">
      <div class="stack contact__intro">
        <Heading tag="h2" size="xxl" fontFamily="primary" weight="fw400" marginBottom="none">
          {title}
        </Heading>

        <p class="lead contact__lead">{lead}</p>

        <div class="plate plate--lg contact__plate">
          <Image
            src={portrait}
            alt="Caregiver talking with a senior woman at home"
            widths={[600, 1200]}
          />
        </div>

        <p class="meta--lg contact__direct">
          Prefer to talk? Call <a href={telHref}>{baseData.phone}</a> or email
          <a href={mailHref}>{baseData.email}</a>.
        </p>
      </div>

      <ContactForm />
    </div>
  </div>
</section>

<style lang="scss">
  .contact {
    &__inner {
      --pad: 6rem;
    }

    &__intro {
      --gap: 1.5rem;
    }

    /* 20ch on the heading keeps "Tell us about your situation." on two lines */
    :global(.fs-xxl) {
      max-width: 20ch;
    }

    &__lead {
      --w: 46ch;
      line-height: 1.6;
    }

    &__plate {
      aspect-ratio: 16 / 10;
      margin-top: 0.5rem;
    }

    &__direct {
      color: var(--qhc-slate-600);
    }
  }
</style>
