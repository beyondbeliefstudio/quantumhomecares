---
/**
 * Homepage Approach. Condensed per buildout-notes/01-home.md: the "Most
 * agencies vs. Quantum" table moved to /our-approach (see
 * ApproachComparison.astro) and Marvalyn's founder block was folded in here,
 * replacing the standalone About section.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";
import Links from "@/components/Links.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// DATA
import { baseData } from "@/data/siteData";

// IMAGES
import portrait from "@/assets/photos/marvalyn_1.jpeg";
---

<section id="approach" class="section" data-reveal>
  <div class="split split--top split--gap-lg">
    <div class="stack approach__copy">
      <span class="eyebrow">Our Approach</span>

      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        Most agencies send help. We <span class="underscore">show up and follow through</span>.
      </Heading>

      <p class="lead">
        Large agencies run on clinical quotas and insurance billing. An aide arrives, hours get
        logged, and your family is still the one on hold with the insurance company at four in the
        afternoon.
      </p>
      <p class="lead">
        We build the care plan, attend the appointments, handle the follow-through, and stay in
        contact before something goes wrong rather than after.
      </p>

      <p class="approach__closer">
        Advocacy is not an add-on service here. It is the reason this company exists.
      </p>

      <Links variant="inline" href="/our-approach" classes="approach__link">
        Read {baseData.owner.name.split(" ")[0]}'s story and how we work
        <Icon name="arrow-right" aria-hidden="true" />
      </Links>
    </div>

    <!-- Founder block: portrait with her story directly beneath it, so the two
         read as one unit rather than a photo floating beside the body copy. -->
    <div class="approach__founder">
      <div class="plate plate--lg approach__plate">
        <Image
          src={portrait}
          alt={`${baseData.owner.name}, founder of ${baseData.legalName}`}
          widths={[500, 1000]}
          sizes="(max-width: 1078px) 92vw, 38vw"
        />
      </div>

      <div class="stack approach__bio">
        <p>
          {baseData.title} was founded by {baseData.owner.name} after more than 25 years in healthcare
          advocacy and senior housing, alongside her own experience managing care for her parents.
          She built the company she wishes her family had.
        </p>
        <p class="meta--lg approach__byline">
          {baseData.owner.name}, {baseData.owner.role} · {baseData.legalName}
        </p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .approach {
    &__copy {
      --gap: 1.25rem;
      max-width: 58ch;
    }

    /* The line the section turns on — set apart from the body it follows, and
       weighted so it reads as a conclusion rather than a third paragraph. */
    &__closer {
      margin-top: 0.5rem;
      padding-left: 1.125rem;
      border-left: 2px solid var(--qhc-navy-300);
      color: var(--qhc-navy-900);
      font-size: var(--qhc-size-body-m);
      font-weight: 600;
      line-height: 1.6;
    }

    &__link {
      margin-top: 0.5rem;
    }

    &__founder {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    &__plate {
      aspect-ratio: 4 / 5;
    }

    &__bio {
      --gap: 1rem;
      padding: 1.625rem 1.75rem;
      background: var(--qhc-white);
      border: 1px solid var(--qhc-hairline);
      border-radius: var(--qhc-radius);
    }

    &__byline {
      padding-top: 1rem;
      border-top: 1px solid var(--qhc-hairline);
      color: var(--qhc-slate-600);
    }

    /* Stacked, source order is the right order: this section is about the
       approach, and the founder block supports it. Deliberately NOT reordered
       the way the old standalone About section was — hoisting the portrait
       above the H2 there made sense because that section was about Marvalyn.
       Here it would strand a photo in front of the heading it belongs to.
       The plate goes landscape so a full-width 4:5 portrait does not eat the
       screen between the copy and the contact block. */
    @media (max-width: 1078px) {
      &__plate {
        aspect-ratio: 3 / 2;
      }
    }
  }
</style>
