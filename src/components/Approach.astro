---
/**
 * Homepage Approach. The copy makes the argument; Marvalyn appears as a
 * figure with a glass caption riding her portrait — signature line and
 * byline over the photo, not a bio paragraph floating under it. Her full
 * story lives on /our-approach, one click away via the inline link.
 */

// COMPONENTS
import Heading from "@/components/Heading.astro";
import Links from "@/components/Links.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// DATA
import { baseData } from "@/data/siteData";

// IMAGES
import portrait from "@/assets/photos/marvalyn_1.jpeg";
---

<section id="approach" class="section" data-reveal>
  <div class="split split--gap-lg approach__split">
    <div class="stack approach__copy">
      <span class="eyebrow">Our Approach</span>

      <Heading tag="h2" size="xl" fontFamily="primary" weight="fw400" marginBottom="none">
        Most agencies send help. We <span class="underscore">show up and follow through</span>.
      </Heading>

      <p class="lead">
        Large agencies run on clinical quotas and insurance billing. An aide arrives, hours get
        logged, and your family is still the one on hold with the insurance company at four in the
        afternoon.
      </p>
      <p class="lead">
        We build the care plan, attend the appointments, handle the follow-through, and stay in
        contact before something goes wrong rather than after.
      </p>

      <p class="approach__closer">
        Advocacy is not an add-on service here. It is the reason this company exists.
      </p>

      <Links variant="inline" href="/our-approach" classes="approach__link">
        Read {baseData.owner.name.split(" ")[0]}'s story and how we work
        <Icon name="arrow-right" aria-hidden="true" />
      </Links>
    </div>

    <!-- The founder as a figure: portrait running the full height of the
         copy, her signature line on glass over its lower edge. -->
    <figure class="approach__figure">
      <div class="plate plate--lg approach__plate" data-drift="5">
        <Image
          src={portrait}
          alt={`${baseData.owner.name}, founder of ${baseData.legalName}`}
          widths={[500, 1000]}
          sizes="(max-width: 1078px) 92vw, 42vw"
        />
      </div>

      <figcaption class="approach__caption">
        <p class="approach__quote">&ldquo;I built the company I wish my family had.&rdquo;</p>
        <p class="approach__byline">
          {baseData.owner.name}, {baseData.owner.role} · {baseData.legalName}
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<style lang="scss">
  .approach {
    /* Stretch, not center — the portrait always runs exactly the height of
       the copy beside it, which is what removes the stranded whitespace the
       old photo-plus-card column left behind. */
    &__split {
      align-items: stretch;
    }

    &__copy {
      --gap: 1.25rem;
      max-width: 58ch;
      align-self: center;
    }

    /* The line the section turns on — emphasis by weight and colour alone. */
    &__closer {
      margin-top: 0.5rem;
      color: var(--qhc-navy-900);
      font-size: var(--qhc-size-body-m);
      font-weight: 600;
      line-height: 1.6;
    }

    &__link {
      margin-top: 0.5rem;
    }

    &__figure {
      position: relative;
      margin: 0;
      /* Floor for short viewports — the copy is usually taller */
      min-height: 30rem;
    }

    &__plate {
      height: 100%;
      overflow: hidden;
      /* Scroll drift comes from data-drift (initPhotoDrift in app.js) —
         GSAP, not animation-timeline, so Safari and Firefox drift too. */
    }

    /* Glass over photography — the caption belongs to the picture */
    &__caption {
      position: absolute;
      inset-inline: 1.25rem;
      bottom: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 1.25rem 1.5rem;
      background: var(--qhc-glass-light);
      backdrop-filter: var(--qhc-glass-blur);
      -webkit-backdrop-filter: var(--qhc-glass-blur);
      border: var(--qhc-glass-edge);
      border-radius: var(--qhc-radius);
    }

    &__quote {
      font-family: var(--qhc-font-display);
      font-size: 1.375rem;
      line-height: 1.3;
      letter-spacing: -0.02em;
      color: var(--qhc-navy-900);
    }

    &__byline {
      font-size: var(--qhc-size-meta);
      line-height: 1.4;
      color: var(--qhc-ink-700);
    }

    /* Stacked: the figure gets its own aspect box (height:100% of an auto
       row collapses), and the caption tightens so it does not swallow the
       narrower photo. */
    @media (max-width: 1078px) {
      &__figure {
        min-height: 0;
        /* Stacked, Marvalyn leads: the portrait reads first, then the
           argument. Desktop keeps copy-left / figure-right DOM order. */
        order: -1;
      }

      &__plate {
        height: auto;
        aspect-ratio: 3 / 2;
      }
    }

    @media (max-width: 616px) {
      &__plate {
        aspect-ratio: 4 / 5;
      }

      &__caption {
        inset-inline: 0.75rem;
        bottom: 0.75rem;
        padding: 1rem 1.125rem;
      }

      &__quote {
        font-size: 1.1875rem;
      }
    }
  }
</style>
