---
// COMPONENTS
import Links from "@/components/Links.astro";

// HELPERS
import { Image } from "astro:assets";

// DATA
import { navData, careersHref, contactHref as defaultContactHref } from "@/data/navData";
import { baseData, telHref, mailHref } from "@/data/siteData";

// IMAGES
import lockup from "@/assets/brand/quantum-logo-full-lockup.png";

// PROPS
/** Layout swaps in the homepage anchor on pages that hide the contact band. */
interface Props {
  contactHref?: string;
}

const { contactHref = defaultContactHref } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="footer" aria-label="Site footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <!-- Brand — the full lockup anchors the footer -->
      <div class="stack footer__brand">
        <a href="/" aria-label={`${baseData.title} — home`}>
          <Image
            src={lockup}
            alt={baseData.title}
            width={400}
            widths={[200, 400]}
            class="footer__lockup"
          />
        </a>
        <p class="meta--lg">Advocacy-led in-home senior care, serving all of New Jersey.</p>

        <div class="footer__credentials">
          <p class="meta">{baseData.credentials.license}</p>
          <p class="meta">{baseData.credentials.insurance}</p>
        </div>
      </div>

      <!-- Explore + Contact — grouped as one unit on the right, opposite the brand -->
      <div class="footer__links-group">
        <nav class="stack footer__col" aria-label="Footer navigation">
          <span class="topic">Explore</span>
          {
            navData.map(i => (
              <Links variant="footer-link" href={i.href}>
                {i.title}
              </Links>
            ))
          }
          <Links variant="footer-link" href={careersHref}>Careers</Links>
          <Links variant="footer-link" href={contactHref}>Request Care</Links>
        </nav>

        <!-- Contact — same footer-link treatment as Explore, so nothing here drifts -->
        <address class="stack footer__col footer__address">
          <span class="topic">Contact</span>
          <Links variant="footer-link" href={telHref}>{baseData.phone}</Links>
          <Links variant="footer-link" href={mailHref}>{baseData.email}</Links>
        </address>
      </div>
    </div>

    <div class="footer__legal">
      <span>
        © {year}
        {baseData.legalName} · Designed by <a
          class="footer__credit"
          href="https://beyondbeliefwebdesign.com/"
          target="_blank"
          rel="noopener noreferrer">Beyond Belief Web Design</a
        >
      </span>
      <nav class="footer__policies" aria-label="Legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/terms-and-conditions">Terms &amp; Conditions</a>
        <span aria-hidden="true">·</span>
        <a href="/accessibility">Accessibility</a>
      </nav>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    border-top: 1px solid var(--qhc-hairline);
    background: var(--qhc-paper);

    &__inner {
      max-width: var(--qhc-page-max);
      margin-inline: auto;
      padding: 4.5rem var(--qhc-gutter) 2.5rem;
    }

    /* Two sides, not three even columns: brand pinned left, nav + contact
       grouped as one unit on the right. space-between puts all the slack
       in the gap between the two sides rather than spreading it evenly. */
    &__grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: start;
      gap: 2.5rem 4rem;
      padding-bottom: 3.5rem;

      /* 1100, not 990: the brand column is wider now, so the row runs out of
         room sooner and would otherwise wrap the links under it. */
      @media (max-width: 1100px) {
        flex-direction: column;
      }
    }

    &__brand {
      --gap: 1.5rem;

      /*
        Grows into the space beside it rather than sitting at a fixed 34ch and
        leaving ~550px of empty footer to its right. The cap keeps the tagline
        to one line on a wide screen without letting the measure run away.
      */
      flex: 1 1 23.75rem;
      max-width: 54ch;

      /* 380px is a width — it only means that while .footer__grid is a row.
         Once the grid flips to column the main axis is vertical, so that same
         basis pins this block to 380px TALL and strands ~155px of empty space
         under the tagline. Release it when the axis flips. */
      @media (max-width: 1100px) {
        flex-basis: auto;
      }
    }

    &__lockup {
      width: auto;
      height: 9.375rem;
    }

    /* The related pair — kept close together as they move as one block */
    &__links-group {
      display: flex;
      flex-wrap: wrap;
      gap: 2.5rem 4rem;

      /* Same breakpoint as .footer__grid — Explore and Contact each get their
         own row rather than pairing up mid-width. */
      @media (max-width: 1100px) {
        flex-direction: column;
      }
    }

    &__col {
      --gap: 0.75rem;

      .topic {
        margin-bottom: 0.375rem;
      }
    }

    &__address {
      font-style: normal;
    }

    &__legal {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5rem 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--qhc-hairline);
      color: var(--qhc-slate-600);
      font-size: var(--qhc-size-meta);
      line-height: 1.6;
    }

    /*
      The policy links get their own full-width row under the copyright line
      rather than competing with it, and they inherit the credit's quiet
      treatment so the whole bar reads as one register.
    */
    /*
      The registration and insurance line reads as part of who the business is,
      so it sits under the brand blurb rather than in the legal bar. Tighter
      than the column's 1.5rem stack gap — these two lines are one fact.
    */
    &__credentials {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    &__policies {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 0.75rem;

      a {
        color: inherit;
        text-decoration-color: var(--qhc-slate-400);

        &:hover,
        &:focus-visible {
          color: var(--qhc-navy-800);
          text-decoration-color: currentColor;
        }
      }
    }

    /*
      The studio credit reads as part of the legal line rather than as a navy
      link shouting out of a muted row: it borrows the row's colour and keeps
      only a faint underline, then warms on hover like every other link.
    */
    &__credit {
      color: inherit;
      text-decoration-color: var(--qhc-slate-400);

      &:hover,
      &:focus-visible {
        color: var(--qhc-navy-800);
        text-decoration-color: currentColor;
      }
    }
  }
</style>
