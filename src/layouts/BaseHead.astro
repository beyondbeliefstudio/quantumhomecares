---
// COMPONENTS
import Analytics from "@/components/Analytics.astro";
import AhrefsAnalytics from "@/components/AhrefsAnalytics.astro";

// DATA
import { baseData, telHref } from "@/data/siteData";

// PROPS
/**
 * `schemaNodes` lets a page append its own structured-data nodes to the shared
 * graph — the homepage passes an FAQPage built from the same data the FAQ
 * section renders. Everything is emitted as one @graph rather than several
 * script tags so the nodes can reference each other by @id.
 */
const {
  pageTitle = baseData.title,
  description = baseData.description,
  schemaNodes = [],
} = Astro.props;

const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const AHREFS_DATA_KEY = import.meta.env.PUBLIC_AHREFS_DATA_KEY;

// Open Graph
const ogImage = new URL("/og-image.png", Astro.site).toString();
const ogUrl = Astro.url.toString();

// Stable @ids so the business and the founder can point at each other, and so
// page-level nodes can attach to the business rather than redeclaring it.
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const businessId = `${siteUrl}/#business`;
const founderId = `${siteUrl}/#founder`;

const business = {
  "@type": ["LocalBusiness", "HomeHealthCareService"],
  "@id": businessId,
  name: baseData.legalName,
  alternateName: baseData.title,
  description: baseData.description,
  url: siteUrl,
  telephone: telHref.replace("tel:", ""),
  email: baseData.email,
  areaServed: { "@type": "State", name: baseData.serviceArea.state },
  // In-home agency — no storefront to publish, so region only.
  address: { "@type": "PostalAddress", addressRegion: "NJ", addressCountry: "US" },
  founder: { "@id": founderId },
  hasCredential: baseData.credentials.license,
};

const founder = {
  "@type": "Person",
  "@id": founderId,
  name: baseData.owner.name,
  jobTitle: baseData.owner.role,
  worksFor: { "@id": businessId },
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [business, founder, ...schemaNodes],
};
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <!-- Declared so scrapers can lay out the card before fetching the file -->
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${baseData.title} — ${baseData.serviceArea.summary}`} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={ogUrl} />
  <meta property="twitter:title" content={pageTitle} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImage} />

  <!-- Fonts — Gambetta (display) is self-hosted; @font-face is in global.scss -->
  <link
    rel="preload"
    href="/fonts/Gambetta-Variable.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!--
    Arms the reveal styles before first paint, so sections never flash in at
    full opacity. See global.scss.

    The hiding is CSS but the un-hiding is JS, so if app.js never arms the
    observer the page below the hero would stay blank. Drop the class in that
    case: losing the animation is fine, losing the content is not.
  -->
  <script is:inline>
    document.documentElement.classList.add("js-reveal");
    addEventListener("load", function () {
      setTimeout(function () {
        if (!("revealReady" in document.documentElement.dataset)) {
          document.documentElement.classList.remove("js-reveal");
        }
      }, 1000);
    });
  </script>

  <script src="@/js/app.js"></script>

  <Analytics measurementId={GA_MEASUREMENT_ID} />
  <AhrefsAnalytics dataKey={AHREFS_DATA_KEY} />
</head>
