---
// COMPONENTS
import Links from "@/components/Links.astro";

// HELPERS
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// DATA
import { navData, desktopNav } from "@/data/navData";
import { baseData, telHref } from "@/data/siteData";

// IMAGES
import wordmark from "@/assets/brand/quantum-wordmark.png";
import mark from "@/assets/brand/quantum-mark.png";
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <!-- Wordmark at rest, heart mark once scrolled. Both live in the same box. -->
    <a href="#top" class="nav__logo" aria-label={`${baseData.title} — back to top`}>
      <Image src={wordmark} alt={baseData.title} height={104} class="nav__wordmark" />
      <Image src={mark} alt="" aria-hidden="true" height={108} class="nav__mark" />
    </a>

    <div class="nav__actions">
      <nav class="nav__links" aria-label="Main navigation">
        {desktopNav.map(i => <Links variant="nav-link" href={i.href}>{i.title}</Links>)}
      </nav>

      <Links variant="primary" href="#contact" classes="sm">Request Care</Links>

      <button
        type="button"
        class="nav__toggle"
        data-nav-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <Icon name="menu" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" data-nav-drawer>
    <div class="nav__drawer-inner">
      {navData.map(i => <Links variant="drawer-link" href={i.href} data-nav-close>{i.title}</Links>)}
      <a href={telHref} class="nav__drawer-phone" data-nav-close>Call {baseData.phone}</a>
      <Links variant="primary" href="#contact" classes="full" data-nav-close>Request Care</Links>
    </div>
  </div>
</header>

<!--
  Scrim. Deliberately a sibling of the header, not a child: .nav carries a
  backdrop-filter, which makes it the containing block for position: fixed
  descendants, so nested here it would size itself to the header instead of
  the viewport. data-nav-close is all the JS it needs — the existing handler
  closes the drawer on click.
-->
<div class="nav__scrim" data-nav-close aria-hidden="true"></div>

<style lang="scss">
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(249, 246, 241, 0.86);
    backdrop-filter: saturate(1.4) blur(18px);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    border-bottom: 1px solid transparent;
    transition:
      background var(--qhc-duration-slow) var(--qhc-ease-out),
      box-shadow var(--qhc-duration-slow) var(--qhc-ease-out),
      border-color var(--qhc-duration-slow) var(--qhc-ease-out);

    /* Past the 40px sentinel — thinner glass, a hairline, and a soft lift */
    &[data-scrolled] {
      background: rgba(249, 246, 241, 0.55);
      backdrop-filter: saturate(1.6) blur(24px);
      -webkit-backdrop-filter: saturate(1.6) blur(24px);
      border-bottom-color: rgba(10, 44, 76, 0.1);
      box-shadow: 0 18px 40px -30px rgba(10, 44, 76, 0.55);
    }

    &__bar {
      display: flex;
      align-items: center;
      gap: 28px;
      max-width: var(--qhc-page-max);
      min-height: var(--qhc-header-h);
      margin-inline: auto;
      padding: 12px 40px;

      @media (max-width: 640px) {
        gap: 16px;
        padding: 12px var(--qhc-gutter);
      }
    }

    /* --- Logo cross-fade --- */
    &__logo {
      position: relative;
      display: block;
      flex: 0 0 auto;
      width: 222px;
      height: 56px;
      transition: width var(--qhc-duration-slow) var(--qhc-ease-out);

      /* The logo is flex: 0 0 auto, so it never gives ground — the right
         cluster is what gets pushed out of the bar. It has to step down
         before the bar runs out of room, not after. 222px stops fitting
         alongside the CTA at ~490px, so the step happens at 560. */
      @media (max-width: 560px) {
        width: 180px;
      }
    }

    &__wordmark,
    &__mark {
      position: absolute;
      left: 0;
      top: 50%;
      width: auto;
      transition: opacity 260ms var(--qhc-ease-out);
    }

    &__wordmark {
      height: 52px;
      transform: translateY(-50%);
      opacity: 1;

      @media (max-width: 560px) {
        height: 44px;
      }
    }

    &__mark {
      height: 54px;
      transform: translateY(-50%) scale(0.9);
      opacity: 0;
      transition:
        opacity 260ms var(--qhc-ease-out),
        transform 320ms var(--qhc-ease-out);
    }

    &[data-scrolled] &__logo {
      width: 68px;
    }
    &[data-scrolled] &__wordmark {
      opacity: 0;
    }
    &[data-scrolled] &__mark {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }

    /* --- Right cluster --- */
    &__actions {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-left: auto;

      /*
        Below this the three pieces genuinely cannot coexist: at 320px the CTA
        and the toggle alone take 223px of a 280px content box, which would
        leave 57px for the wordmark — illegible at any height. The drawer
        already carries a full-width Request Care button and the phone link,
        so the header CTA is the piece to drop rather than the logo.
      */
      @media (max-width: 480px) {
        :global(.btn.primary) {
          display: none;
        }
      }
    }

    &__links {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-right: 16px;

      @media (max-width: 1200px) {
        gap: 18px;
      }

      @media (max-width: 1020px) {
        display: none;
      }
    }

    &__toggle {
      display: none;
      place-items: center;
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 1px solid var(--qhc-navy-200);
      border-radius: var(--qhc-radius-circle);
      background: var(--qhc-navy-100);
      color: var(--qhc-navy-800);
      cursor: pointer;
      transition: background var(--qhc-duration-fast) var(--qhc-ease-out);

      &:hover {
        background: var(--qhc-navy-200);
      }

      svg {
        width: 22px;
        height: 22px;
      }

      @media (max-width: 1020px) {
        display: grid;
      }
    }

    /* --- Mobile drawer --- */
    &__drawer {
      display: none;
      border-top: 1px solid var(--qhc-hairline);
      background: rgba(249, 246, 241, 0.98);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    &.is-open &__drawer {
      @media (max-width: 1020px) {
        display: block;
      }
    }

    /* --- Scrim behind the drawer ---
       z-index sits under .nav (40) so the header and drawer stay legible on
       top of it, and over everything else on the page. Fades rather than
       snapping; visibility is in the transition so it is not a click target
       while hidden. */
    &__scrim {
      position: fixed;
      inset: 0;
      z-index: 30;
      background: var(--qhc-glass-light);
      backdrop-filter: var(--qhc-glass-blur);
      -webkit-backdrop-filter: var(--qhc-glass-blur);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--qhc-duration-base) var(--qhc-ease-out),
        visibility var(--qhc-duration-base) var(--qhc-ease-out);
    }

    /* Only below the drawer breakpoint — the drawer itself cannot open above it */
    &.is-open + &__scrim {
      @media (max-width: 1020px) {
        opacity: 1;
        visibility: visible;
      }
    }

    &__drawer-inner {
      display: flex;
      flex-direction: column;
      max-width: var(--qhc-page-max);
      margin-inline: auto;
      padding: 8px 40px 24px;

      @media (max-width: 640px) {
        padding: 8px var(--qhc-gutter) 24px;
      }

      /* The CTA pill sits below the link list, not inside it */
      :global(.btn.primary) {
        min-height: 56px;
        margin-top: 8px;
      }
    }

    /* Mirrors .drawer-link in Links.astro — same height, rule, size, weight
       and hover, so the phone number reads as the last row of the list
       rather than a differently-styled outlier. */
    &__drawer-phone {
      display: flex;
      align-items: center;
      min-height: 52px;
      border-bottom: 1px solid var(--qhc-hairline);
      color: var(--qhc-ink-900);
      font-size: var(--qhc-size-body-m);
      font-weight: 500;
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--qhc-ember-700);
      }
    }
  }
</style>
